set shell := ["bash", "-euc"]

default:
    @just --list

# Verify the tools required by the standalone browser and service packages.
doctor:
    command -v bun >/dev/null
    command -v cargo >/dev/null
    command -v wasm-bindgen >/dev/null
    rustup target list --installed | grep -qx wasm32-unknown-unknown

# Install the pinned Bun dependencies.
install: doctor
    cd browser && bun install --frozen-lockfile

# Type-check, test, and bundle the browser interface.
frontend: install
    cd browser && bun run check

# Build the Rust bridge and package its wasm-bindgen output with the browser bundle.
wasm: frontend
    cd browser/wasm && ./build.sh

# Build the desktop service after all browser assets are ready for embedding.
build: wasm
    cargo build --locked --release --manifest-path service/Cargo.toml

# Build and start a temporary LAN chat room.
run: build
    cargo run --locked --release --manifest-path service/Cargo.toml

# Run the Rust and Bun checks without producing a release service binary.
check: install
    cd browser && bun run check
    cargo check --locked --target wasm32-unknown-unknown --manifest-path browser/wasm/Cargo.toml
    cargo test --locked --manifest-path service/Cargo.toml
    cargo clippy --locked --manifest-path service/Cargo.toml --all-targets -- -D warnings

# Remove generated browser and standalone Rust build output.
clean:
    rm -rf browser/dist browser/wasm/target service/target
