set shell := ["bash", "-euc"]

default:
    @just --list

# Verify the tools required by the browser package.
doctor:
    command -v bun >/dev/null
    command -v cargo >/dev/null
    command -v wasm-bindgen >/dev/null
    rustup target list --installed | grep -qx wasm32-unknown-unknown

# Install the locked Bun dependencies.
install: doctor
    cd browser && bun install --frozen-lockfile

# Type-check and test the Bun application without changing packaged output.
frontend-check: install
    cd browser && bun run lint
    cd browser && bun test

# Build the hashed browser assets.
frontend: install
    cd browser && bun run build

# Type-check the Rust bridge against the browser target.
wasm-check: doctor
    cargo fmt --manifest-path browser/wasm/Cargo.toml -- --check
    cargo check --locked --target wasm32-unknown-unknown --manifest-path browser/wasm/Cargo.toml

# Package wasm-bindgen output after the frontend has created a clean dist directory.
wasm: frontend
    cd browser/wasm && ./build.sh

# Build the complete static application.
build: wasm
    test -f browser/dist/index.html
    test -f browser/dist/wasm/browser_p2p.js
    test -f browser/dist/wasm/browser_p2p_bg.wasm

# Build and start the Bun static/rendezvous service.
run: build
    cd browser && bun run serve

# Run focused checks without starting the service.
check: frontend-check wasm-check
    cargo check -p commonware-webrtc
    cargo check --target wasm32-unknown-unknown -p commonware-webrtc

# Remove generated browser output.
clean:
    rm -rf browser/dist browser/wasm/target
