-- SDM k1[j]: bit j of an __mmask8.
def[prelude] x86_64::kbit8 : (k : U8) -> (j : U32) -> Bool :=
  fun (k : U8) (j : U32) => #eq_u8(#and_u8(#wshr_u8(k, j), 1u8), 1u8)

-- `r[j] = f(j, a[j], b[j])` for j < 8.
def[prelude] x86_64::imap2_u64x8 : (f : U32 -> U64 -> U64 -> U64) -> (a : Array U64 8usize) -> (b : Array U64 8usize) -> Array U64 8usize :=
