-- _mm512_sllv_epi64 — VPSLLVQ zmm1, zmm2, zmm3/m512 (avx512f); src/x86_64/avx512.rs.
def[intrinsic] x86_64::_mm512_sllv_epi64 :
    (a : Array U8 64usize) -> (count : Array U8 64usize) -> Array U8 64usize :=
  fun (a : Array U8 64usize) (count : Array U8 64usize) =>
    x86_64::from_u64x8 (x86_64::map2_u64x8 (fun (x : U64) (y : U64) => if #lt_u64(y, 64u64) return U64 then #wshl_u64(x, #cast_u64_u32(y)) else 0u64) (x86_64::view_u64x8 a) (x86_64::view_u64x8 count))

