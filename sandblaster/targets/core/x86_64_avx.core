    x86_64::from_u64x8 (x86_64::map2_u64x8 (fun (x : U64) (y : U64) => if #lt_u64(y, 64u64) return U64 then #wshr_u64(x, #cast_u64_u32(y)) else 0u64) (x86_64::view_u64x8 a) (x86_64::view_u64x8 count))

-- _mm512_shuffle_epi8 — VPSHUFB zmm1, zmm2, zmm3/m512 (avx512bw); src/x86_64/avx512.rs.
def[intrinsic] x86_64::_mm512_shuffle_epi8 :
    (a : Array U8 64usize) -> (b : Array U8 64usize) -> Array U8 64usize :=
  fun (a : Array U8 64usize) (b : Array U8 64usize) =>
    let t : Array (Array U8 16usize) 4usize = x86_64::lanes128_u8x64 a;
    let t0 : Array U8 16usize = array::index (Array U8 16usize) 4usize t 0usize .refl(Bool, true);
    let t1 : Array U8 16usize = array::index (Array U8 16usize) 4usize t 1usize .refl(Bool, true);
    let t2 : Array U8 16usize = array::index (Array U8 16usize) 4usize t 2usize .refl(Bool, true);
    let t3 : Array U8 16usize = array::index (Array U8 16usize) 4usize t 3usize .refl(Bool, true);
    x86_64::u8x64
      (x86_64::pshufb_byte t0 (array::index U8 64usize b 0usize .refl(Bool, true)))
      (x86_64::pshufb_byte t0 (array::index U8 64usize b 1usize .refl(Bool, true)))
      (x86_64::pshufb_byte t0 (array::index U8 64usize b 2usize .refl(Bool, true)))
      (x86_64::pshufb_byte t0 (array::index U8 64usize b 3usize .refl(Bool, true)))
