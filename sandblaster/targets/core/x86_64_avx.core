    x86_64::concat4_u8x16 (x86_64::select4 la MASK) (x86_64::select4 la (#wshr_u32(MASK, 2u32)))
      (x86_64::select4 lb (#wshr_u32(MASK, 4u32))) (x86_64::select4 lb (#wshr_u32(MASK, 6u32)))

