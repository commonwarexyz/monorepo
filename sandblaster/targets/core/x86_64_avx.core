      (x86_64::pshufb_byte t0 (array::index U8 64usize b 9usize .refl(Bool, true)))
      (x86_64::pshufb_byte t0 (array::index U8 64usize b 10usize .refl(Bool, true)))
      (x86_64::pshufb_byte t0 (array::index U8 64usize b 11usize .refl(Bool, true)))
      (x86_64::pshufb_byte t0 (array::index U8 64usize b 12usize .refl(Bool, true)))
      (x86_64::pshufb_byte t0 (array::index U8 64usize b 13usize .refl(Bool, true)))
      (x86_64::pshufb_byte t0 (array::index U8 64usize b 14usize .refl(Bool, true)))
