-- The __mmask8 whose bit j is c_j (DEST[j] := 1 iff CMP).
def[prelude] x86_64::mask8_of : (c0 : Bool) -> (c1 : Bool) -> (c2 : Bool) -> (c3 : Bool) -> (c4 : Bool) -> (c5 : Bool) -> (c6 : Bool) -> (c7 : Bool) -> U8 :=
  fun (c0 : Bool) (c1 : Bool) (c2 : Bool) (c3 : Bool) (c4 : Bool) (c5 : Bool) (c6 : Bool) (c7 : Bool) =>
    #or_u8(bool::as_u8 c0, #or_u8(#wshl_u8(bool::as_u8 c1, 1u32), #or_u8(#wshl_u8(bool::as_u8 c2, 2u32), #or_u8(#wshl_u8(bool::as_u8 c3, 3u32), #or_u8(#wshl_u8(bool::as_u8 c4, 4u32), #or_u8(#wshl_u8(bool::as_u8 c5, 5u32), #or_u8(#wshl_u8(bool::as_u8 c6, 6u32), #wshl_u8(bool::as_u8 c7, 7u32))))))))

-- The __mmask16 whose bit j is c_j (DEST[j] := 1 iff CMP).
def[prelude] x86_64::mask16_of : (c0 : Bool) -> (c1 : Bool) -> (c2 : Bool) -> (c3 : Bool) -> (c4 : Bool) -> (c5 : Bool) -> (c6 : Bool) -> (c7 : Bool) -> (c8 : Bool) -> (c9 : Bool) -> (c10 : Bool) -> (c11 : Bool) -> (c12 : Bool) -> (c13 : Bool) -> (c14 : Bool) -> (c15 : Bool) -> U16 :=
  fun (c0 : Bool) (c1 : Bool) (c2 : Bool) (c3 : Bool) (c4 : Bool) (c5 : Bool) (c6 : Bool) (c7 : Bool) (c8 : Bool) (c9 : Bool) (c10 : Bool) (c11 : Bool) (c12 : Bool) (c13 : Bool) (c14 : Bool) (c15 : Bool) =>
    #or_u16(bool::as_u16 c0, #or_u16(#wshl_u16(bool::as_u16 c1, 1u32), #or_u16(#wshl_u16(bool::as_u16 c2, 2u32), #or_u16(#wshl_u16(bool::as_u16 c3, 3u32), #or_u16(#wshl_u16(bool::as_u16 c4, 4u32), #or_u16(#wshl_u16(bool::as_u16 c5, 5u32), #or_u16(#wshl_u16(bool::as_u16 c6, 6u32), #or_u16(#wshl_u16(bool::as_u16 c7, 7u32), #or_u16(#wshl_u16(bool::as_u16 c8, 8u32), #or_u16(#wshl_u16(bool::as_u16 c9, 9u32), #or_u16(#wshl_u16(bool::as_u16 c10, 10u32), #or_u16(#wshl_u16(bool::as_u16 c11, 11u32), #or_u16(#wshl_u16(bool::as_u16 c12, 12u32), #or_u16(#wshl_u16(bool::as_u16 c13, 13u32), #or_u16(#wshl_u16(bool::as_u16 c14, 14u32), #wshl_u16(bool::as_u16 c15, 15u32))))))))))))))))

-- `r[j] = f(j, a[j])` for j < 16.
def[prelude] x86_64::imap_u32x16 : (f : U32 -> U32 -> U32) -> (a : Array U32 16usize) -> Array U32 16usize :=
  fun (f : U32 -> U32 -> U32) (a : Array U32 16usize) =>
    x86_64::u32x16
      (f 0u32 (array::index U32 16usize a 0usize .refl(Bool, true)))
      (f 1u32 (array::index U32 16usize a 1usize .refl(Bool, true)))
      (f 2u32 (array::index U32 16usize a 2usize .refl(Bool, true)))
      (f 3u32 (array::index U32 16usize a 3usize .refl(Bool, true)))
      (f 4u32 (array::index U32 16usize a 4usize .refl(Bool, true)))
      (f 5u32 (array::index U32 16usize a 5usize .refl(Bool, true)))
      (f 6u32 (array::index U32 16usize a 6usize .refl(Bool, true)))
      (f 7u32 (array::index U32 16usize a 7usize .refl(Bool, true)))
      (f 8u32 (array::index U32 16usize a 8usize .refl(Bool, true)))
      (f 9u32 (array::index U32 16usize a 9usize .refl(Bool, true)))
      (f 10u32 (array::index U32 16usize a 10usize .refl(Bool, true)))
      (f 11u32 (array::index U32 16usize a 11usize .refl(Bool, true)))
      (f 12u32 (array::index U32 16usize a 12usize .refl(Bool, true)))
      (f 13u32 (array::index U32 16usize a 13usize .refl(Bool, true)))
      (f 14u32 (array::index U32 16usize a 14usize .refl(Bool, true)))
