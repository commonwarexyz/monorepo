      (x86_64::pshufb_byte t1 (array::index U8 64usize b 16usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 17usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 18usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 19usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 20usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 21usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 22usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 23usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 24usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 25usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 26usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 27usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 28usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 29usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 30usize .refl(Bool, true)))
      (x86_64::pshufb_byte t1 (array::index U8 64usize b 31usize .refl(Bool, true)))
      (x86_64::pshufb_byte t2 (array::index U8 64usize b 32usize .refl(Bool, true)))
      (x86_64::pshufb_byte t2 (array::index U8 64usize b 33usize .refl(Bool, true)))
      (x86_64::pshufb_byte t2 (array::index U8 64usize b 34usize .refl(Bool, true)))
      (x86_64::pshufb_byte t2 (array::index U8 64usize b 35usize .refl(Bool, true)))
      (x86_64::pshufb_byte t2 (array::index U8 64usize b 36usize .refl(Bool, true)))
      (x86_64::pshufb_byte t2 (array::index U8 64usize b 37usize .refl(Bool, true)))
