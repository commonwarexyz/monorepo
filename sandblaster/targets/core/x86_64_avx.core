      (f 1u32 (array::index U64 8usize a 1usize .refl(Bool, true)) (array::index U64 8usize b 1usize .refl(Bool, true)))
      (f 2u32 (array::index U64 8usize a 2usize .refl(Bool, true)) (array::index U64 8usize b 2usize .refl(Bool, true)))
      (f 3u32 (array::index U64 8usize a 3usize .refl(Bool, true)) (array::index U64 8usize b 3usize .refl(Bool, true)))
      (f 4u32 (array::index U64 8usize a 4usize .refl(Bool, true)) (array::index U64 8usize b 4usize .refl(Bool, true)))
      (f 5u32 (array::index U64 8usize a 5usize .refl(Bool, true)) (array::index U64 8usize b 5usize .refl(Bool, true)))
