-- The 2 128-bit lanes of a 32-byte vector, lane 0 first.
def[prelude] x86_64::lanes128_u8x32 : (a : Array U8 32usize) -> Array (Array U8 16usize) 2usize :=
  fun (a : Array U8 32usize) =>
    pair(Array (Array U8 16usize) 2usize,
      Cons[Array U8 16usize](x86_64::u8x16 (array::index U8 32usize a 0usize .refl(Bool, true)) (array::index U8 32usize a 1usize .refl(Bool, true)) (array::index U8 32usize a 2usize .refl(Bool, true)) (array::index U8 32usize a 3usize .refl(Bool, true)) (array::index U8 32usize a 4usize .refl(Bool, true)) (array::index U8 32usize a 5usize .refl(Bool, true)) (array::index U8 32usize a 6usize .refl(Bool, true)) (array::index U8 32usize a 7usize .refl(Bool, true)) (array::index U8 32usize a 8usize .refl(Bool, true)) (array::index U8 32usize a 9usize .refl(Bool, true)) (array::index U8 32usize a 10usize .refl(Bool, true)) (array::index U8 32usize a 11usize .refl(Bool, true)) (array::index U8 32usize a 12usize .refl(Bool, true)) (array::index U8 32usize a 13usize .refl(Bool, true)) (array::index U8 32usize a 14usize .refl(Bool, true)) (array::index U8 32usize a 15usize .refl(Bool, true)),
        Cons[Array U8 16usize](x86_64::u8x16 (array::index U8 32usize a 16usize .refl(Bool, true)) (array::index U8 32usize a 17usize .refl(Bool, true)) (array::index U8 32usize a 18usize .refl(Bool, true)) (array::index U8 32usize a 19usize .refl(Bool, true)) (array::index U8 32usize a 20usize .refl(Bool, true)) (array::index U8 32usize a 21usize .refl(Bool, true)) (array::index U8 32usize a 22usize .refl(Bool, true)) (array::index U8 32usize a 23usize .refl(Bool, true)) (array::index U8 32usize a 24usize .refl(Bool, true)) (array::index U8 32usize a 25usize .refl(Bool, true)) (array::index U8 32usize a 26usize .refl(Bool, true)) (array::index U8 32usize a 27usize .refl(Bool, true)) (array::index U8 32usize a 28usize .refl(Bool, true)) (array::index U8 32usize a 29usize .refl(Bool, true)) (array::index U8 32usize a 30usize .refl(Bool, true)) (array::index U8 32usize a 31usize .refl(Bool, true)),
        Nil[Array U8 16usize])),
      refl(Int, 2int))

-- `r[j] = f(j, a[j], b[j])` for j < 8.
def[prelude] x86_64::imap2_u32x8 : (f : U32 -> U32 -> U32 -> U32) -> (a : Array U32 8usize) -> (b : Array U32 8usize) -> Array U32 8usize :=
  fun (f : U32 -> U32 -> U32 -> U32) (a : Array U32 8usize) (b : Array U32 8usize) =>
    x86_64::u32x8
      (f 0u32 (array::index U32 8usize a 0usize .refl(Bool, true)) (array::index U32 8usize b 0usize .refl(Bool, true)))
      (f 1u32 (array::index U32 8usize a 1usize .refl(Bool, true)) (array::index U32 8usize b 1usize .refl(Bool, true)))
      (f 2u32 (array::index U32 8usize a 2usize .refl(Bool, true)) (array::index U32 8usize b 2usize .refl(Bool, true)))
      (f 3u32 (array::index U32 8usize a 3usize .refl(Bool, true)) (array::index U32 8usize b 3usize .refl(Bool, true)))
      (f 4u32 (array::index U32 8usize a 4usize .refl(Bool, true)) (array::index U32 8usize b 4usize .refl(Bool, true)))
      (f 5u32 (array::index U32 8usize a 5usize .refl(Bool, true)) (array::index U32 8usize b 5usize .refl(Bool, true)))
      (f 6u32 (array::index U32 8usize a 6usize .refl(Bool, true)) (array::index U32 8usize b 6usize .refl(Bool, true)))
      (f 7u32 (array::index U32 8usize a 7usize .refl(Bool, true)) (array::index U32 8usize b 7usize .refl(Bool, true)))

