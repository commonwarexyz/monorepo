def[prelude] x86_64::madd52hi : (acc : U64) -> (b : U64) -> (c : U64) -> U64 :=
  fun (acc : U64) (b : U64) (c : U64) =>
    let t : Int = #imul(#cast_u64_int(#and_u64(b, 4503599627370495u64)), #cast_u64_int(#and_u64(c, 4503599627370495u64)));
    #wadd_u64(acc, #int_to_sat_u64(#imod(#idiv(t, 4503599627370496int), 4503599627370496int)))

-- SDM gf2p8mul_byte: carry-less product (t_{i+1} = t_i XOR (src1byte << i) if src2byte.bit[i]),
-- then reduction by 0x11B << (i-8) for i = 14 downto 8; the low byte.
def[prelude] x86_64::gf2p8mul_byte : (src1byte : U8) -> (src2byte : U8) -> U8 :=
  fun (src1byte : U8) (src2byte : U8) =>
    let s : U16 = #cast_u8_u16(src1byte);
    let t0 : U16 = 0u16;
    let t1 : U16 = if #ne_u8(#and_u8(src2byte, 1u8), 0u8) return U16 then #xor_u16(t0, #wshl_u16(s, 0u32)) else t0;
    let t2 : U16 = if #ne_u8(#and_u8(src2byte, 2u8), 0u8) return U16 then #xor_u16(t1, #wshl_u16(s, 1u32)) else t1;
    let t3 : U16 = if #ne_u8(#and_u8(src2byte, 4u8), 0u8) return U16 then #xor_u16(t2, #wshl_u16(s, 2u32)) else t2;
    let t4 : U16 = if #ne_u8(#and_u8(src2byte, 8u8), 0u8) return U16 then #xor_u16(t3, #wshl_u16(s, 3u32)) else t3;
    let t5 : U16 = if #ne_u8(#and_u8(src2byte, 16u8), 0u8) return U16 then #xor_u16(t4, #wshl_u16(s, 4u32)) else t4;
    let t6 : U16 = if #ne_u8(#and_u8(src2byte, 32u8), 0u8) return U16 then #xor_u16(t5, #wshl_u16(s, 5u32)) else t5;
    let t7 : U16 = if #ne_u8(#and_u8(src2byte, 64u8), 0u8) return U16 then #xor_u16(t6, #wshl_u16(s, 6u32)) else t6;
    let t8 : U16 = if #ne_u8(#and_u8(src2byte, 128u8), 0u8) return U16 then #xor_u16(t7, #wshl_u16(s, 7u32)) else t7;
    let r14 : U16 = if #ne_u16(#and_u16(t8, 16384u16), 0u16) return U16 then #xor_u16(t8, 18112u16) else t8;
    let r13 : U16 = if #ne_u16(#and_u16(r14, 8192u16), 0u16) return U16 then #xor_u16(r14, 9056u16) else r14;
    let r12 : U16 = if #ne_u16(#and_u16(r13, 4096u16), 0u16) return U16 then #xor_u16(r13, 4528u16) else r13;
    let r11 : U16 = if #ne_u16(#and_u16(r12, 2048u16), 0u16) return U16 then #xor_u16(r12, 2264u16) else r12;
    let r10 : U16 = if #ne_u16(#and_u16(r11, 1024u16), 0u16) return U16 then #xor_u16(r11, 1132u16) else r11;
    let r9 : U16 = if #ne_u16(#and_u16(r10, 512u16), 0u16) return U16 then #xor_u16(r10, 566u16) else r10;
    let r8 : U16 = if #ne_u16(#and_u16(r9, 256u16), 0u16) return U16 then #xor_u16(r9, 283u16) else r9;
    #cast_u16_u8(r8)

