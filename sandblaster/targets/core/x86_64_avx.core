    (IMM8 : U32) -> (.hIMM8 : Eq(Bool, #le_u32(IMM8, 255u32), true)) -> (a : Array U8 64usize) -> Array U8 64usize :=
  fun (IMM8 : U32) (.hIMM8 : Eq(Bool, #le_u32(IMM8, 255u32), true)) (a : Array U8 64usize) =>
    x86_64::from_u32x16 (x86_64::map_u32x16 (fun (x : U32) => if #le_u32(IMM8, 31u32) return U32 then #wshr_u32(x, IMM8) else 0u32) (x86_64::view_u32x16 a))

