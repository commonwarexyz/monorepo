def[prelude] x86_64::map2_u8x32 : (f : U8 -> U8 -> U8) -> (a : Array U8 32usize) -> (b : Array U8 32usize) -> Array U8 32usize :=
  fun (f : U8 -> U8 -> U8) (a : Array U8 32usize) (b : Array U8 32usize) =>
    x86_64::u8x32
      (f (array::index U8 32usize a 0usize .refl(Bool, true)) (array::index U8 32usize b 0usize .refl(Bool, true)))
      (f (array::index U8 32usize a 1usize .refl(Bool, true)) (array::index U8 32usize b 1usize .refl(Bool, true)))
