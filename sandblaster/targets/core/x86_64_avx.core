      (f (array::index U32 16usize a 8usize .refl(Bool, true)))
      (f (array::index U32 16usize a 9usize .refl(Bool, true)))
      (f (array::index U32 16usize a 10usize .refl(Bool, true)))
      (f (array::index U32 16usize a 11usize .refl(Bool, true)))
      (f (array::index U32 16usize a 12usize .refl(Bool, true)))
      (f (array::index U32 16usize a 13usize .refl(Bool, true)))
      (f (array::index U32 16usize a 14usize .refl(Bool, true)))
      (f (array::index U32 16usize a 15usize .refl(Bool, true)))

-- `r[j] = f(a[j])` for j < 8.
def[prelude] x86_64::map_u64x8 : (f : U64 -> U64) -> (a : Array U64 8usize) -> Array U64 8usize :=
  fun (f : U64 -> U64) (a : Array U64 8usize) =>
    x86_64::u64x8
      (f (array::index U64 8usize a 0usize .refl(Bool, true)))
      (f (array::index U64 8usize a 1usize .refl(Bool, true)))
      (f (array::index U64 8usize a 2usize .refl(Bool, true)))
