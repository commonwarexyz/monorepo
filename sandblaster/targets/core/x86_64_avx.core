    let l5 : U32 = array::index U32 16usize l 5usize .refl(Bool, true);
    let l6 : U32 = array::index U32 16usize l 6usize .refl(Bool, true);
    let l7 : U32 = array::index U32 16usize l 7usize .refl(Bool, true);
    let l8 : U32 = array::index U32 16usize l 8usize .refl(Bool, true);
    let l9 : U32 = array::index U32 16usize l 9usize .refl(Bool, true);
    let l10 : U32 = array::index U32 16usize l 10usize .refl(Bool, true);
    let l11 : U32 = array::index U32 16usize l 11usize .refl(Bool, true);
    let l12 : U32 = array::index U32 16usize l 12usize .refl(Bool, true);
    let l13 : U32 = array::index U32 16usize l 13usize .refl(Bool, true);
    let l14 : U32 = array::index U32 16usize l 14usize .refl(Bool, true);
    let l15 : U32 = array::index U32 16usize l 15usize .refl(Bool, true);
    x86_64::u8x64
      (#cast_u32_u8(l0)) (#cast_u32_u8(#wshr_u32(l0, 8u32))) (#cast_u32_u8(#wshr_u32(l0, 16u32))) (#cast_u32_u8(#wshr_u32(l0, 24u32)))
      (#cast_u32_u8(l1)) (#cast_u32_u8(#wshr_u32(l1, 8u32))) (#cast_u32_u8(#wshr_u32(l1, 16u32))) (#cast_u32_u8(#wshr_u32(l1, 24u32)))
      (#cast_u32_u8(l2)) (#cast_u32_u8(#wshr_u32(l2, 8u32))) (#cast_u32_u8(#wshr_u32(l2, 16u32))) (#cast_u32_u8(#wshr_u32(l2, 24u32)))
      (#cast_u32_u8(l3)) (#cast_u32_u8(#wshr_u32(l3, 8u32))) (#cast_u32_u8(#wshr_u32(l3, 16u32))) (#cast_u32_u8(#wshr_u32(l3, 24u32)))
      (#cast_u32_u8(l4)) (#cast_u32_u8(#wshr_u32(l4, 8u32))) (#cast_u32_u8(#wshr_u32(l4, 16u32))) (#cast_u32_u8(#wshr_u32(l4, 24u32)))
      (#cast_u32_u8(l5)) (#cast_u32_u8(#wshr_u32(l5, 8u32))) (#cast_u32_u8(#wshr_u32(l5, 16u32))) (#cast_u32_u8(#wshr_u32(l5, 24u32)))
      (#cast_u32_u8(l6)) (#cast_u32_u8(#wshr_u32(l6, 8u32))) (#cast_u32_u8(#wshr_u32(l6, 16u32))) (#cast_u32_u8(#wshr_u32(l6, 24u32)))
      (#cast_u32_u8(l7)) (#cast_u32_u8(#wshr_u32(l7, 8u32))) (#cast_u32_u8(#wshr_u32(l7, 16u32))) (#cast_u32_u8(#wshr_u32(l7, 24u32)))
      (#cast_u32_u8(l8)) (#cast_u32_u8(#wshr_u32(l8, 8u32))) (#cast_u32_u8(#wshr_u32(l8, 16u32))) (#cast_u32_u8(#wshr_u32(l8, 24u32)))
      (#cast_u32_u8(l9)) (#cast_u32_u8(#wshr_u32(l9, 8u32))) (#cast_u32_u8(#wshr_u32(l9, 16u32))) (#cast_u32_u8(#wshr_u32(l9, 24u32)))
      (#cast_u32_u8(l10)) (#cast_u32_u8(#wshr_u32(l10, 8u32))) (#cast_u32_u8(#wshr_u32(l10, 16u32))) (#cast_u32_u8(#wshr_u32(l10, 24u32)))
      (#cast_u32_u8(l11)) (#cast_u32_u8(#wshr_u32(l11, 8u32))) (#cast_u32_u8(#wshr_u32(l11, 16u32))) (#cast_u32_u8(#wshr_u32(l11, 24u32)))
      (#cast_u32_u8(l12)) (#cast_u32_u8(#wshr_u32(l12, 8u32))) (#cast_u32_u8(#wshr_u32(l12, 16u32))) (#cast_u32_u8(#wshr_u32(l12, 24u32)))
      (#cast_u32_u8(l13)) (#cast_u32_u8(#wshr_u32(l13, 8u32))) (#cast_u32_u8(#wshr_u32(l13, 16u32))) (#cast_u32_u8(#wshr_u32(l13, 24u32)))
      (#cast_u32_u8(l14)) (#cast_u32_u8(#wshr_u32(l14, 8u32))) (#cast_u32_u8(#wshr_u32(l14, 16u32))) (#cast_u32_u8(#wshr_u32(l14, 24u32)))
      (#cast_u32_u8(l15)) (#cast_u32_u8(#wshr_u32(l15, 8u32))) (#cast_u32_u8(#wshr_u32(l15, 16u32))) (#cast_u32_u8(#wshr_u32(l15, 24u32)))

-- `[x0, .., x7]` as `Array U64 8usize`.
def[prelude] x86_64::u64x8 :
    (x0 : U64) -> (x1 : U64) -> (x2 : U64) -> (x3 : U64) -> (x4 : U64) -> (x5 : U64) -> (x6 : U64) -> (x7 : U64) ->
    Array U64 8usize :=
  fun
    (x0 : U64) (x1 : U64) (x2 : U64) (x3 : U64) (x4 : U64) (x5 : U64) (x6 : U64) (x7 : U64) =>
    pair(Array U64 8usize,
      Cons[U64](x0, Cons[U64](x1, Cons[U64](x2, Cons[U64](x3, Cons[U64](x4, Cons[U64](x5, Cons[U64](x6, Cons[U64](x7, Nil[U64])))))))),
      refl(Int, 8int))

-- `r[j] = f(a[j], b[j])` for j < 8.
def[prelude] x86_64::map2_u64x8 : (f : U64 -> U64 -> U64) -> (a : Array U64 8usize) -> (b : Array U64 8usize) -> Array U64 8usize :=
  fun (f : U64 -> U64 -> U64) (a : Array U64 8usize) (b : Array U64 8usize) =>
    x86_64::u64x8
      (f (array::index U64 8usize a 0usize .refl(Bool, true)) (array::index U64 8usize b 0usize .refl(Bool, true)))
      (f (array::index U64 8usize a 1usize .refl(Bool, true)) (array::index U64 8usize b 1usize .refl(Bool, true)))
      (f (array::index U64 8usize a 2usize .refl(Bool, true)) (array::index U64 8usize b 2usize .refl(Bool, true)))
      (f (array::index U64 8usize a 3usize .refl(Bool, true)) (array::index U64 8usize b 3usize .refl(Bool, true)))
      (f (array::index U64 8usize a 4usize .refl(Bool, true)) (array::index U64 8usize b 4usize .refl(Bool, true)))
      (f (array::index U64 8usize a 5usize .refl(Bool, true)) (array::index U64 8usize b 5usize .refl(Bool, true)))
      (f (array::index U64 8usize a 6usize .refl(Bool, true)) (array::index U64 8usize b 6usize .refl(Bool, true)))
      (f (array::index U64 8usize a 7usize .refl(Bool, true)) (array::index U64 8usize b 7usize .refl(Bool, true)))

-- view_u64x8 v [j] = u64::from_le_bytes [v[8j], .., v[8j+7]] (little-endian lanes).
def[prelude] x86_64::view_u64x8 : (v : Array U8 64usize) -> Array U64 8usize :=
  fun (v : Array U8 64usize) =>
    let v0 : U8 = array::index U8 64usize v 0usize .refl(Bool, true);
    let v1 : U8 = array::index U8 64usize v 1usize .refl(Bool, true);
    let v2 : U8 = array::index U8 64usize v 2usize .refl(Bool, true);
    let v3 : U8 = array::index U8 64usize v 3usize .refl(Bool, true);
    let v4 : U8 = array::index U8 64usize v 4usize .refl(Bool, true);
    let v5 : U8 = array::index U8 64usize v 5usize .refl(Bool, true);
    let v6 : U8 = array::index U8 64usize v 6usize .refl(Bool, true);
    let v7 : U8 = array::index U8 64usize v 7usize .refl(Bool, true);
    let v8 : U8 = array::index U8 64usize v 8usize .refl(Bool, true);
    let v9 : U8 = array::index U8 64usize v 9usize .refl(Bool, true);
    let v10 : U8 = array::index U8 64usize v 10usize .refl(Bool, true);
    let v11 : U8 = array::index U8 64usize v 11usize .refl(Bool, true);
    let v12 : U8 = array::index U8 64usize v 12usize .refl(Bool, true);
    let v13 : U8 = array::index U8 64usize v 13usize .refl(Bool, true);
    let v14 : U8 = array::index U8 64usize v 14usize .refl(Bool, true);
    let v15 : U8 = array::index U8 64usize v 15usize .refl(Bool, true);
    let v16 : U8 = array::index U8 64usize v 16usize .refl(Bool, true);
    let v17 : U8 = array::index U8 64usize v 17usize .refl(Bool, true);
    let v18 : U8 = array::index U8 64usize v 18usize .refl(Bool, true);
    let v19 : U8 = array::index U8 64usize v 19usize .refl(Bool, true);
    let v20 : U8 = array::index U8 64usize v 20usize .refl(Bool, true);
    let v21 : U8 = array::index U8 64usize v 21usize .refl(Bool, true);
    let v22 : U8 = array::index U8 64usize v 22usize .refl(Bool, true);
    let v23 : U8 = array::index U8 64usize v 23usize .refl(Bool, true);
    let v24 : U8 = array::index U8 64usize v 24usize .refl(Bool, true);
    let v25 : U8 = array::index U8 64usize v 25usize .refl(Bool, true);
    let v26 : U8 = array::index U8 64usize v 26usize .refl(Bool, true);
    let v27 : U8 = array::index U8 64usize v 27usize .refl(Bool, true);
    let v28 : U8 = array::index U8 64usize v 28usize .refl(Bool, true);
    let v29 : U8 = array::index U8 64usize v 29usize .refl(Bool, true);
    let v30 : U8 = array::index U8 64usize v 30usize .refl(Bool, true);
    let v31 : U8 = array::index U8 64usize v 31usize .refl(Bool, true);
    let v32 : U8 = array::index U8 64usize v 32usize .refl(Bool, true);
    let v33 : U8 = array::index U8 64usize v 33usize .refl(Bool, true);
    let v34 : U8 = array::index U8 64usize v 34usize .refl(Bool, true);
    let v35 : U8 = array::index U8 64usize v 35usize .refl(Bool, true);
    let v36 : U8 = array::index U8 64usize v 36usize .refl(Bool, true);
    let v37 : U8 = array::index U8 64usize v 37usize .refl(Bool, true);
    let v38 : U8 = array::index U8 64usize v 38usize .refl(Bool, true);
    let v39 : U8 = array::index U8 64usize v 39usize .refl(Bool, true);
    let v40 : U8 = array::index U8 64usize v 40usize .refl(Bool, true);
    let v41 : U8 = array::index U8 64usize v 41usize .refl(Bool, true);
    let v42 : U8 = array::index U8 64usize v 42usize .refl(Bool, true);
    let v43 : U8 = array::index U8 64usize v 43usize .refl(Bool, true);
    let v44 : U8 = array::index U8 64usize v 44usize .refl(Bool, true);
    let v45 : U8 = array::index U8 64usize v 45usize .refl(Bool, true);
    let v46 : U8 = array::index U8 64usize v 46usize .refl(Bool, true);
    let v47 : U8 = array::index U8 64usize v 47usize .refl(Bool, true);
    let v48 : U8 = array::index U8 64usize v 48usize .refl(Bool, true);
    let v49 : U8 = array::index U8 64usize v 49usize .refl(Bool, true);
    let v50 : U8 = array::index U8 64usize v 50usize .refl(Bool, true);
    let v51 : U8 = array::index U8 64usize v 51usize .refl(Bool, true);
    let v52 : U8 = array::index U8 64usize v 52usize .refl(Bool, true);
    let v53 : U8 = array::index U8 64usize v 53usize .refl(Bool, true);
    let v54 : U8 = array::index U8 64usize v 54usize .refl(Bool, true);
    let v55 : U8 = array::index U8 64usize v 55usize .refl(Bool, true);
    let v56 : U8 = array::index U8 64usize v 56usize .refl(Bool, true);
    let v57 : U8 = array::index U8 64usize v 57usize .refl(Bool, true);
    let v58 : U8 = array::index U8 64usize v 58usize .refl(Bool, true);
    let v59 : U8 = array::index U8 64usize v 59usize .refl(Bool, true);
    let v60 : U8 = array::index U8 64usize v 60usize .refl(Bool, true);
    let v61 : U8 = array::index U8 64usize v 61usize .refl(Bool, true);
    let v62 : U8 = array::index U8 64usize v 62usize .refl(Bool, true);
    let v63 : U8 = array::index U8 64usize v 63usize .refl(Bool, true);
    x86_64::u64x8
      (u64::from_le_bytes (x86_64::u8x8 v0 v1 v2 v3 v4 v5 v6 v7))
      (u64::from_le_bytes (x86_64::u8x8 v8 v9 v10 v11 v12 v13 v14 v15))
      (u64::from_le_bytes (x86_64::u8x8 v16 v17 v18 v19 v20 v21 v22 v23))
      (u64::from_le_bytes (x86_64::u8x8 v24 v25 v26 v27 v28 v29 v30 v31))
      (u64::from_le_bytes (x86_64::u8x8 v32 v33 v34 v35 v36 v37 v38 v39))
      (u64::from_le_bytes (x86_64::u8x8 v40 v41 v42 v43 v44 v45 v46 v47))
      (u64::from_le_bytes (x86_64::u8x8 v48 v49 v50 v51 v52 v53 v54 v55))
      (u64::from_le_bytes (x86_64::u8x8 v56 v57 v58 v59 v60 v61 v62 v63))

-- Inverse of view_u64x8: byte 8j + b is cast_u8(l[j] >> 8b).
def[prelude] x86_64::from_u64x8 : (l : Array U64 8usize) -> Array U8 64usize :=
  fun (l : Array U64 8usize) =>
    let l0 : U64 = array::index U64 8usize l 0usize .refl(Bool, true);
    let l1 : U64 = array::index U64 8usize l 1usize .refl(Bool, true);
    let l2 : U64 = array::index U64 8usize l 2usize .refl(Bool, true);
    let l3 : U64 = array::index U64 8usize l 3usize .refl(Bool, true);
    let l4 : U64 = array::index U64 8usize l 4usize .refl(Bool, true);
    let l5 : U64 = array::index U64 8usize l 5usize .refl(Bool, true);
    let l6 : U64 = array::index U64 8usize l 6usize .refl(Bool, true);
    let l7 : U64 = array::index U64 8usize l 7usize .refl(Bool, true);
    x86_64::u8x64
      (#cast_u64_u8(l0)) (#cast_u64_u8(#wshr_u64(l0, 8u32))) (#cast_u64_u8(#wshr_u64(l0, 16u32))) (#cast_u64_u8(#wshr_u64(l0, 24u32))) (#cast_u64_u8(#wshr_u64(l0, 32u32))) (#cast_u64_u8(#wshr_u64(l0, 40u32))) (#cast_u64_u8(#wshr_u64(l0, 48u32))) (#cast_u64_u8(#wshr_u64(l0, 56u32)))
      (#cast_u64_u8(l1)) (#cast_u64_u8(#wshr_u64(l1, 8u32))) (#cast_u64_u8(#wshr_u64(l1, 16u32))) (#cast_u64_u8(#wshr_u64(l1, 24u32))) (#cast_u64_u8(#wshr_u64(l1, 32u32))) (#cast_u64_u8(#wshr_u64(l1, 40u32))) (#cast_u64_u8(#wshr_u64(l1, 48u32))) (#cast_u64_u8(#wshr_u64(l1, 56u32)))
      (#cast_u64_u8(l2)) (#cast_u64_u8(#wshr_u64(l2, 8u32))) (#cast_u64_u8(#wshr_u64(l2, 16u32))) (#cast_u64_u8(#wshr_u64(l2, 24u32))) (#cast_u64_u8(#wshr_u64(l2, 32u32))) (#cast_u64_u8(#wshr_u64(l2, 40u32))) (#cast_u64_u8(#wshr_u64(l2, 48u32))) (#cast_u64_u8(#wshr_u64(l2, 56u32)))
      (#cast_u64_u8(l3)) (#cast_u64_u8(#wshr_u64(l3, 8u32))) (#cast_u64_u8(#wshr_u64(l3, 16u32))) (#cast_u64_u8(#wshr_u64(l3, 24u32))) (#cast_u64_u8(#wshr_u64(l3, 32u32))) (#cast_u64_u8(#wshr_u64(l3, 40u32))) (#cast_u64_u8(#wshr_u64(l3, 48u32))) (#cast_u64_u8(#wshr_u64(l3, 56u32)))
      (#cast_u64_u8(l4)) (#cast_u64_u8(#wshr_u64(l4, 8u32))) (#cast_u64_u8(#wshr_u64(l4, 16u32))) (#cast_u64_u8(#wshr_u64(l4, 24u32))) (#cast_u64_u8(#wshr_u64(l4, 32u32))) (#cast_u64_u8(#wshr_u64(l4, 40u32))) (#cast_u64_u8(#wshr_u64(l4, 48u32))) (#cast_u64_u8(#wshr_u64(l4, 56u32)))
      (#cast_u64_u8(l5)) (#cast_u64_u8(#wshr_u64(l5, 8u32))) (#cast_u64_u8(#wshr_u64(l5, 16u32))) (#cast_u64_u8(#wshr_u64(l5, 24u32))) (#cast_u64_u8(#wshr_u64(l5, 32u32))) (#cast_u64_u8(#wshr_u64(l5, 40u32))) (#cast_u64_u8(#wshr_u64(l5, 48u32))) (#cast_u64_u8(#wshr_u64(l5, 56u32)))
      (#cast_u64_u8(l6)) (#cast_u64_u8(#wshr_u64(l6, 8u32))) (#cast_u64_u8(#wshr_u64(l6, 16u32))) (#cast_u64_u8(#wshr_u64(l6, 24u32))) (#cast_u64_u8(#wshr_u64(l6, 32u32))) (#cast_u64_u8(#wshr_u64(l6, 40u32))) (#cast_u64_u8(#wshr_u64(l6, 48u32))) (#cast_u64_u8(#wshr_u64(l6, 56u32)))
      (#cast_u64_u8(l7)) (#cast_u64_u8(#wshr_u64(l7, 8u32))) (#cast_u64_u8(#wshr_u64(l7, 16u32))) (#cast_u64_u8(#wshr_u64(l7, 24u32))) (#cast_u64_u8(#wshr_u64(l7, 32u32))) (#cast_u64_u8(#wshr_u64(l7, 40u32))) (#cast_u64_u8(#wshr_u64(l7, 48u32))) (#cast_u64_u8(#wshr_u64(l7, 56u32)))

-- VPTERNLOG on one element, as the sum of the minterms selected by imm: bit k of the result is
-- imm[(x_k << 2) + (y_k << 1) + z_k] (the SDM's table lookup), i.e. the OR over m = 0..7 with
-- imm[m] = 1 of (m[2] ? x : NOT x) AND (m[1] ? y : NOT y) AND (m[0] ? z : NOT z).
def[prelude] x86_64::ternlog_u32 : (imm : U32) -> (x : U32) -> (y : U32) -> (z : U32) -> U32 :=
  fun (imm : U32) (x : U32) (y : U32) (z : U32) =>
    #or_u32((if #eq_u32(#and_u32(#wshr_u32(imm, 0u32), 1u32), 1u32) return U32 then #and_u32(#and_u32(#not_u32(x), #not_u32(y)), #not_u32(z)) else 0u32),
      #or_u32((if #eq_u32(#and_u32(#wshr_u32(imm, 1u32), 1u32), 1u32) return U32 then #and_u32(#and_u32(#not_u32(x), #not_u32(y)), z) else 0u32),
      #or_u32((if #eq_u32(#and_u32(#wshr_u32(imm, 2u32), 1u32), 1u32) return U32 then #and_u32(#and_u32(#not_u32(x), y), #not_u32(z)) else 0u32),
      #or_u32((if #eq_u32(#and_u32(#wshr_u32(imm, 3u32), 1u32), 1u32) return U32 then #and_u32(#and_u32(#not_u32(x), y), z) else 0u32),
      #or_u32((if #eq_u32(#and_u32(#wshr_u32(imm, 4u32), 1u32), 1u32) return U32 then #and_u32(#and_u32(x, #not_u32(y)), #not_u32(z)) else 0u32),
      #or_u32((if #eq_u32(#and_u32(#wshr_u32(imm, 5u32), 1u32), 1u32) return U32 then #and_u32(#and_u32(x, #not_u32(y)), z) else 0u32),
      #or_u32((if #eq_u32(#and_u32(#wshr_u32(imm, 6u32), 1u32), 1u32) return U32 then #and_u32(#and_u32(x, y), #not_u32(z)) else 0u32),
      (if #eq_u32(#and_u32(#wshr_u32(imm, 7u32), 1u32), 1u32) return U32 then #and_u32(#and_u32(x, y), z) else 0u32))))))))

-- `r[j] = f(a[j], b[j], c[j])` for j < 16.
def[prelude] x86_64::map3_u32x16 : (f : U32 -> U32 -> U32 -> U32) -> (a : Array U32 16usize) -> (b : Array U32 16usize) -> (c : Array U32 16usize) -> Array U32 16usize :=
  fun (f : U32 -> U32 -> U32 -> U32) (a : Array U32 16usize) (b : Array U32 16usize) (c : Array U32 16usize) =>
    x86_64::u32x16
      (f (array::index U32 16usize a 0usize .refl(Bool, true)) (array::index U32 16usize b 0usize .refl(Bool, true)) (array::index U32 16usize c 0usize .refl(Bool, true)))
      (f (array::index U32 16usize a 1usize .refl(Bool, true)) (array::index U32 16usize b 1usize .refl(Bool, true)) (array::index U32 16usize c 1usize .refl(Bool, true)))
      (f (array::index U32 16usize a 2usize .refl(Bool, true)) (array::index U32 16usize b 2usize .refl(Bool, true)) (array::index U32 16usize c 2usize .refl(Bool, true)))
      (f (array::index U32 16usize a 3usize .refl(Bool, true)) (array::index U32 16usize b 3usize .refl(Bool, true)) (array::index U32 16usize c 3usize .refl(Bool, true)))
      (f (array::index U32 16usize a 4usize .refl(Bool, true)) (array::index U32 16usize b 4usize .refl(Bool, true)) (array::index U32 16usize c 4usize .refl(Bool, true)))
      (f (array::index U32 16usize a 5usize .refl(Bool, true)) (array::index U32 16usize b 5usize .refl(Bool, true)) (array::index U32 16usize c 5usize .refl(Bool, true)))
      (f (array::index U32 16usize a 6usize .refl(Bool, true)) (array::index U32 16usize b 6usize .refl(Bool, true)) (array::index U32 16usize c 6usize .refl(Bool, true)))
      (f (array::index U32 16usize a 7usize .refl(Bool, true)) (array::index U32 16usize b 7usize .refl(Bool, true)) (array::index U32 16usize c 7usize .refl(Bool, true)))
      (f (array::index U32 16usize a 8usize .refl(Bool, true)) (array::index U32 16usize b 8usize .refl(Bool, true)) (array::index U32 16usize c 8usize .refl(Bool, true)))
      (f (array::index U32 16usize a 9usize .refl(Bool, true)) (array::index U32 16usize b 9usize .refl(Bool, true)) (array::index U32 16usize c 9usize .refl(Bool, true)))
      (f (array::index U32 16usize a 10usize .refl(Bool, true)) (array::index U32 16usize b 10usize .refl(Bool, true)) (array::index U32 16usize c 10usize .refl(Bool, true)))
      (f (array::index U32 16usize a 11usize .refl(Bool, true)) (array::index U32 16usize b 11usize .refl(Bool, true)) (array::index U32 16usize c 11usize .refl(Bool, true)))
      (f (array::index U32 16usize a 12usize .refl(Bool, true)) (array::index U32 16usize b 12usize .refl(Bool, true)) (array::index U32 16usize c 12usize .refl(Bool, true)))
      (f (array::index U32 16usize a 13usize .refl(Bool, true)) (array::index U32 16usize b 13usize .refl(Bool, true)) (array::index U32 16usize c 13usize .refl(Bool, true)))
      (f (array::index U32 16usize a 14usize .refl(Bool, true)) (array::index U32 16usize b 14usize .refl(Bool, true)) (array::index U32 16usize c 14usize .refl(Bool, true)))
      (f (array::index U32 16usize a 15usize .refl(Bool, true)) (array::index U32 16usize b 15usize .refl(Bool, true)) (array::index U32 16usize c 15usize .refl(Bool, true)))

-- VPTERNLOG on one element, as the sum of the minterms selected by imm: bit k of the result is
-- imm[(x_k << 2) + (y_k << 1) + z_k] (the SDM's table lookup), i.e. the OR over m = 0..7 with
-- imm[m] = 1 of (m[2] ? x : NOT x) AND (m[1] ? y : NOT y) AND (m[0] ? z : NOT z).
def[prelude] x86_64::ternlog_u64 : (imm : U32) -> (x : U64) -> (y : U64) -> (z : U64) -> U64 :=
  fun (imm : U32) (x : U64) (y : U64) (z : U64) =>
    #or_u64((if #eq_u32(#and_u32(#wshr_u32(imm, 0u32), 1u32), 1u32) return U64 then #and_u64(#and_u64(#not_u64(x), #not_u64(y)), #not_u64(z)) else 0u64),
      #or_u64((if #eq_u32(#and_u32(#wshr_u32(imm, 1u32), 1u32), 1u32) return U64 then #and_u64(#and_u64(#not_u64(x), #not_u64(y)), z) else 0u64),
      #or_u64((if #eq_u32(#and_u32(#wshr_u32(imm, 2u32), 1u32), 1u32) return U64 then #and_u64(#and_u64(#not_u64(x), y), #not_u64(z)) else 0u64),
      #or_u64((if #eq_u32(#and_u32(#wshr_u32(imm, 3u32), 1u32), 1u32) return U64 then #and_u64(#and_u64(#not_u64(x), y), z) else 0u64),
      #or_u64((if #eq_u32(#and_u32(#wshr_u32(imm, 4u32), 1u32), 1u32) return U64 then #and_u64(#and_u64(x, #not_u64(y)), #not_u64(z)) else 0u64),
      #or_u64((if #eq_u32(#and_u32(#wshr_u32(imm, 5u32), 1u32), 1u32) return U64 then #and_u64(#and_u64(x, #not_u64(y)), z) else 0u64),
      #or_u64((if #eq_u32(#and_u32(#wshr_u32(imm, 6u32), 1u32), 1u32) return U64 then #and_u64(#and_u64(x, y), #not_u64(z)) else 0u64),
      (if #eq_u32(#and_u32(#wshr_u32(imm, 7u32), 1u32), 1u32) return U64 then #and_u64(#and_u64(x, y), z) else 0u64))))))))

-- `r[j] = f(a[j], b[j], c[j])` for j < 8.
def[prelude] x86_64::map3_u64x8 : (f : U64 -> U64 -> U64 -> U64) -> (a : Array U64 8usize) -> (b : Array U64 8usize) -> (c : Array U64 8usize) -> Array U64 8usize :=
  fun (f : U64 -> U64 -> U64 -> U64) (a : Array U64 8usize) (b : Array U64 8usize) (c : Array U64 8usize) =>
    x86_64::u64x8
      (f (array::index U64 8usize a 0usize .refl(Bool, true)) (array::index U64 8usize b 0usize .refl(Bool, true)) (array::index U64 8usize c 0usize .refl(Bool, true)))
      (f (array::index U64 8usize a 1usize .refl(Bool, true)) (array::index U64 8usize b 1usize .refl(Bool, true)) (array::index U64 8usize c 1usize .refl(Bool, true)))
      (f (array::index U64 8usize a 2usize .refl(Bool, true)) (array::index U64 8usize b 2usize .refl(Bool, true)) (array::index U64 8usize c 2usize .refl(Bool, true)))
      (f (array::index U64 8usize a 3usize .refl(Bool, true)) (array::index U64 8usize b 3usize .refl(Bool, true)) (array::index U64 8usize c 3usize .refl(Bool, true)))
      (f (array::index U64 8usize a 4usize .refl(Bool, true)) (array::index U64 8usize b 4usize .refl(Bool, true)) (array::index U64 8usize c 4usize .refl(Bool, true)))
      (f (array::index U64 8usize a 5usize .refl(Bool, true)) (array::index U64 8usize b 5usize .refl(Bool, true)) (array::index U64 8usize c 5usize .refl(Bool, true)))
      (f (array::index U64 8usize a 6usize .refl(Bool, true)) (array::index U64 8usize b 6usize .refl(Bool, true)) (array::index U64 8usize c 6usize .refl(Bool, true)))
      (f (array::index U64 8usize a 7usize .refl(Bool, true)) (array::index U64 8usize b 7usize .refl(Bool, true)) (array::index U64 8usize c 7usize .refl(Bool, true)))

-- `r[j] = f(a[j])` for j < 16.
def[prelude] x86_64::map_u32x16 : (f : U32 -> U32) -> (a : Array U32 16usize) -> Array U32 16usize :=
  fun (f : U32 -> U32) (a : Array U32 16usize) =>
    x86_64::u32x16
