-- SDM parity(x): t := 0; FOR i := 0 to 7: t = t xor x.bit[i] (an xor of bit extractions).
def[prelude] x86_64::gf2_parity : (x : U8) -> U8 :=
  fun (x : U8) =>
    let t0 : U8 = 0u8;
    let t1 : U8 = #xor_u8(t0, #and_u8(#wshr_u8(x, 0u32), 1u8));
    let t2 : U8 = #xor_u8(t1, #and_u8(#wshr_u8(x, 1u32), 1u8));
    let t3 : U8 = #xor_u8(t2, #and_u8(#wshr_u8(x, 2u32), 1u8));
    let t4 : U8 = #xor_u8(t3, #and_u8(#wshr_u8(x, 3u32), 1u8));
    let t5 : U8 = #xor_u8(t4, #and_u8(#wshr_u8(x, 4u32), 1u8));
    let t6 : U8 = #xor_u8(t5, #and_u8(#wshr_u8(x, 5u32), 1u8));
    let t7 : U8 = #xor_u8(t6, #and_u8(#wshr_u8(x, 6u32), 1u8));
    let t8 : U8 = #xor_u8(t7, #and_u8(#wshr_u8(x, 7u32), 1u8));
    t8

-- SDM affine_byte: retbyte.bit[i] := parity(tsrc2qw.byte[7-i] AND src1byte) XOR imm8.bit[i].
def[prelude] x86_64::gf2p8_affine_byte : (tsrc2qw : U64) -> (src1byte : U8) -> (imm : U32) -> U8 :=
  fun (tsrc2qw : U64) (src1byte : U8) (imm : U32) =>
    let r0 : U8 = #xor_u8(x86_64::gf2_parity (#and_u8(#cast_u64_u8(#wshr_u64(tsrc2qw, 56u32)), src1byte)), #and_u8(#cast_u32_u8(#wshr_u32(imm, 0u32)), 1u8));
    let r1 : U8 = #xor_u8(x86_64::gf2_parity (#and_u8(#cast_u64_u8(#wshr_u64(tsrc2qw, 48u32)), src1byte)), #and_u8(#cast_u32_u8(#wshr_u32(imm, 1u32)), 1u8));
    let r2 : U8 = #xor_u8(x86_64::gf2_parity (#and_u8(#cast_u64_u8(#wshr_u64(tsrc2qw, 40u32)), src1byte)), #and_u8(#cast_u32_u8(#wshr_u32(imm, 2u32)), 1u8));
    let r3 : U8 = #xor_u8(x86_64::gf2_parity (#and_u8(#cast_u64_u8(#wshr_u64(tsrc2qw, 32u32)), src1byte)), #and_u8(#cast_u32_u8(#wshr_u32(imm, 3u32)), 1u8));
    let r4 : U8 = #xor_u8(x86_64::gf2_parity (#and_u8(#cast_u64_u8(#wshr_u64(tsrc2qw, 24u32)), src1byte)), #and_u8(#cast_u32_u8(#wshr_u32(imm, 4u32)), 1u8));
    let r5 : U8 = #xor_u8(x86_64::gf2_parity (#and_u8(#cast_u64_u8(#wshr_u64(tsrc2qw, 16u32)), src1byte)), #and_u8(#cast_u32_u8(#wshr_u32(imm, 5u32)), 1u8));
    let r6 : U8 = #xor_u8(x86_64::gf2_parity (#and_u8(#cast_u64_u8(#wshr_u64(tsrc2qw, 8u32)), src1byte)), #and_u8(#cast_u32_u8(#wshr_u32(imm, 6u32)), 1u8));
    let r7 : U8 = #xor_u8(x86_64::gf2_parity (#and_u8(#cast_u64_u8(#wshr_u64(tsrc2qw, 0u32)), src1byte)), #and_u8(#cast_u32_u8(#wshr_u32(imm, 7u32)), 1u8));
    #or_u8(r0, #or_u8(#wshl_u8(r1, 1u32), #or_u8(#wshl_u8(r2, 2u32), #or_u8(#wshl_u8(r3, 3u32), #or_u8(#wshl_u8(r4, 4u32), #or_u8(#wshl_u8(r5, 5u32), #or_u8(#wshl_u8(r6, 6u32), #wshl_u8(r7, 7u32))))))))

-- SDM inverse(x) (the table of GF2P8AFFINEINVQB): x^254 = x^2 x^4 .. x^128 in GF(2^8) mod 0x11B
-- (inverse(0) = 0); the square-and-multiply chain of the executable model.
def[prelude] x86_64::gf2p8_inverse : (x : U8) -> U8 :=
  fun (x : U8) =>
    let s0 : U8 = x;
    let a0 : U8 = 1u8;
    let s1 : U8 = x86_64::gf2p8mul_byte s0 s0;
    let a1 : U8 = x86_64::gf2p8mul_byte a0 s1;
    let s2 : U8 = x86_64::gf2p8mul_byte s1 s1;
    let a2 : U8 = x86_64::gf2p8mul_byte a1 s2;
    let s3 : U8 = x86_64::gf2p8mul_byte s2 s2;
    let a3 : U8 = x86_64::gf2p8mul_byte a2 s3;
    let s4 : U8 = x86_64::gf2p8mul_byte s3 s3;
    let a4 : U8 = x86_64::gf2p8mul_byte a3 s4;
    let s5 : U8 = x86_64::gf2p8mul_byte s4 s4;
    let a5 : U8 = x86_64::gf2p8mul_byte a4 s5;
    let s6 : U8 = x86_64::gf2p8mul_byte s5 s5;
    let a6 : U8 = x86_64::gf2p8mul_byte a5 s6;
    let s7 : U8 = x86_64::gf2p8mul_byte s6 s6;
    let a7 : U8 = x86_64::gf2p8mul_byte a6 s7;
    a7

-- One VPMULTISHIFTQB byte: ctrl := c & 63; res.bit[k] := tcur.bit[(ctrl+k) mod 64] for k < 8.
def[prelude] x86_64::multishift_byte : (tcur : U64) -> (c : U8) -> U8 :=
  fun (tcur : U64) (c : U8) =>
    let ctrl : U32 = #cast_u8_u32(#and_u8(c, 63u8));
    let b0 : U8 = #cast_u64_u8(#and_u64(#wshr_u64(tcur, #and_u32(#wadd_u32(ctrl, 0u32), 63u32)), 1u64));
    let b1 : U8 = #cast_u64_u8(#and_u64(#wshr_u64(tcur, #and_u32(#wadd_u32(ctrl, 1u32), 63u32)), 1u64));
    let b2 : U8 = #cast_u64_u8(#and_u64(#wshr_u64(tcur, #and_u32(#wadd_u32(ctrl, 2u32), 63u32)), 1u64));
    let b3 : U8 = #cast_u64_u8(#and_u64(#wshr_u64(tcur, #and_u32(#wadd_u32(ctrl, 3u32), 63u32)), 1u64));
    let b4 : U8 = #cast_u64_u8(#and_u64(#wshr_u64(tcur, #and_u32(#wadd_u32(ctrl, 4u32), 63u32)), 1u64));
    let b5 : U8 = #cast_u64_u8(#and_u64(#wshr_u64(tcur, #and_u32(#wadd_u32(ctrl, 5u32), 63u32)), 1u64));
    let b6 : U8 = #cast_u64_u8(#and_u64(#wshr_u64(tcur, #and_u32(#wadd_u32(ctrl, 6u32), 63u32)), 1u64));
    let b7 : U8 = #cast_u64_u8(#and_u64(#wshr_u64(tcur, #and_u32(#wadd_u32(ctrl, 7u32), 63u32)), 1u64));
    #or_u8(b0, #or_u8(#wshl_u8(b1, 1u32), #or_u8(#wshl_u8(b2, 2u32), #or_u8(#wshl_u8(b3, 3u32), #or_u8(#wshl_u8(b4, 4u32), #or_u8(#wshl_u8(b5, 5u32), #or_u8(#wshl_u8(b6, 6u32), #wshl_u8(b7, 7u32))))))))

-- VBMI2 SHLD on one element: concat(hi, lo) << s, the upper half (s < 64): hi for s = 0, else
-- (hi << s) OR (lo >> (64 - s)).
def[prelude] x86_64::shld_u64 : (hi : U64) -> (lo : U64) -> (s : U32) -> U64 :=
  fun (hi : U64) (lo : U64) (s : U32) =>
    if #eq_u32(s, 0u32) return U64 then hi else #or_u64(#wshl_u64(hi, s), #wshr_u64(lo, #wsub_u32(64u32, s)))

-- VBMI2 SHRD on one element: concat(hi, lo) >> s, the lower half (s < 64): lo for s = 0, else
-- (lo >> s) OR (hi << (64 - s)).
def[prelude] x86_64::shrd_u64 : (lo : U64) -> (hi : U64) -> (s : U32) -> U64 :=
  fun (lo : U64) (hi : U64) (s : U32) =>
    if #eq_u32(s, 0u32) return U64 then lo else #or_u64(#wshr_u64(lo, s), #wshl_u64(hi, #wsub_u32(64u32, s)))

-- VBMI2 SHLD on one element: concat(hi, lo) << s, the upper half (s < 32): hi for s = 0, else
-- (hi << s) OR (lo >> (32 - s)).
def[prelude] x86_64::shld_u32 : (hi : U32) -> (lo : U32) -> (s : U32) -> U32 :=
  fun (hi : U32) (lo : U32) (s : U32) =>
    if #eq_u32(s, 0u32) return U32 then hi else #or_u32(#wshl_u32(hi, s), #wshr_u32(lo, #wsub_u32(32u32, s)))

-- VBMI2 SHRD on one element: concat(hi, lo) >> s, the lower half (s < 32): lo for s = 0, else
-- (lo >> s) OR (hi << (32 - s)).
def[prelude] x86_64::shrd_u32 : (lo : U32) -> (hi : U32) -> (s : U32) -> U32 :=
  fun (lo : U32) (hi : U32) (s : U32) =>
    if #eq_u32(s, 0u32) return U32 then lo else #or_u32(#wshr_u32(lo, s), #wshl_u32(hi, #wsub_u32(32u32, s)))

