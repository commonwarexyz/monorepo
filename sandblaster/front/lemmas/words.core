-- sandblaster lemma library: word forms of byte comparisons (optimizer design
-- §12.4, plan O4). Eight byte comparisons are one comparison of the
-- little-endian words (`word::eq8`), and `(x ⊕ y) | t == 0` splits into
-- `x == y` and `t == 0` (`word::xor_or_eq0`). The Σ1 driver's `Word` step
-- rewrites a static-length `seq::eq` of bytes (`[u8; 8m] == [u8; 8m]`) into
-- `((a₀ ⊕ b₀) | … | (a_{m−1} ⊕ b_{m−1})) == 0` over `u64::from_le_bytes`
-- words with `word::eq8_or` / `word::eq8_last`, one block of eight bytes at
-- a time (`opt::proof::build`, `Step::Word`).
--
-- Checked, untrusted. Not by linarith (must-reject R24): base-256
-- uniqueness needs the byte extraction `cast_u8(from_le(a) >> 8i) = aᵢ`
-- (`bvrefl`) and `eq_sound` / `eq_complete`, by case analysis.

-- `c == true` makes `c && k` be `k`.
def[lemma] bool::and_true_left : (c : Bool) -> (k : Bool) -> (.h : Eq(Bool, c, true)) -> Eq(Bool, bool::and c k, k) :=
  fun (c : Bool) (k : Bool) (.h : Eq(Bool, c, true)) =>
    transport(Bool, true, c, eq::sym Bool c true h, y. Eq(Bool, bool::and y k, k), refl(Bool, k))

-- Equal little-endian words have equal bytes: `aᵢ = cast_u8(from_le(a) >> 8i)`.
def[lemma] word::byte0 : (a0 : U8) -> (a1 : U8) -> (a2 : U8) -> (a3 : U8) -> (a4 : U8) -> (a5 : U8) -> (a6 : U8) -> (a7 : U8) -> (b0 : U8) -> (b1 : U8) -> (b2 : U8) -> (b3 : U8) -> (b4 : U8) -> (b5 : U8) -> (b6 : U8) -> (b7 : U8) -> (.h : Eq(U64, u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int))))) -> Eq(U8, a0, b0) :=
  fun (a0 : U8) (a1 : U8) (a2 : U8) (a3 : U8) (a4 : U8) (a5 : U8) (a6 : U8) (a7 : U8) (b0 : U8) (b1 : U8) (b2 : U8) (b3 : U8) (b4 : U8) (b5 : U8) (b6 : U8) (b7 : U8) (.h : Eq(U64, u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int))))) =>
    eq::trans U8 a0 (#cast_u64_u8(#wshr_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int))), 0u32))) b0
      (transport(U64, u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int))), h, z. Eq(U8, a0, #cast_u64_u8(#wshr_u64(z, 0u32))), bvrefl(U8, a0, #cast_u64_u8(#wshr_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), 0u32)))))
      (bvrefl(U8, #cast_u64_u8(#wshr_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int))), 0u32)), b0))

