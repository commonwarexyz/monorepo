              let .hxy : Eq(U64, x, y) = eq::trans U64 x (#xor_u64(#and_u64(#xor_u64(x, y), 0u64), y)) y (eq::promote U64 x (#xor_u64(#and_u64(#xor_u64(x, y), 0u64), y)) .hx) (bvrefl(U64, #xor_u64(#and_u64(#xor_u64(x, y), 0u64), y), y));
              absurd(Eq(Bool, true, false), u64::ne_sound x y .e hxy)
          end) .refl(Bool, #eq_u64(#or_u64(#xor_u64(x, y), z), 0u64))
     | true => fun (.e : Eq(Bool, #eq_u64(x, y), true)) =>
         let .hxy : Eq(U64, x, y) = u64::eq_sound x y .e;
         transport(U64, x, y, hxy, w. Eq(Bool, #eq_u64(#or_u64(#xor_u64(x, w), z), 0u64), #eq_u64(z, 0u64)),
           eq::cong U64 Bool (fun (v : U64) => #eq_u64(v, 0u64)) (#or_u64(#xor_u64(x, x), z)) z (bvrefl(U64, #or_u64(#xor_u64(x, x), z), z)))
     end) .refl(Bool, #eq_u64(x, y))

-- `x ⊕ y == 0` is `x == y` (as `x == y && true`, the end of a comparison chain).
def[lemma] word::xor_eq0 : (x : U64) -> (y : U64) -> Eq(Bool, #eq_u64(#xor_u64(x, y), 0u64), bool::and (#eq_u64(x, y)) true) :=
  fun (x : U64) (y : U64) =>
    (match #eq_u64(x, y) : Bool as w return (.e : Eq(Bool, #eq_u64(x, y), w)) -> Eq(Bool, #eq_u64(#xor_u64(x, y), 0u64), bool::and w true) with
     | false => fun (.e : Eq(Bool, #eq_u64(x, y), false)) =>
         (match #eq_u64(#xor_u64(x, y), 0u64) : Bool as w return (.c : Eq(Bool, #eq_u64(#xor_u64(x, y), 0u64), w)) -> Eq(Bool, w, false) with
          | false => fun (.c : Eq(Bool, #eq_u64(#xor_u64(x, y), 0u64), false)) => refl(Bool, false)
          | true => fun (.c : Eq(Bool, #eq_u64(#xor_u64(x, y), 0u64), true)) =>
              let .h0 : Eq(U64, #xor_u64(x, y), 0u64) = u64::eq_sound (#xor_u64(x, y)) 0u64 .c;
              let .hx : Eq(U64, x, #xor_u64(0u64, y)) =
                transport(U64, #xor_u64(x, y), 0u64, h0, w. Eq(U64, x, #xor_u64(w, y)), bvrefl(U64, x, #xor_u64(#xor_u64(x, y), y)));
              let .hxy : Eq(U64, x, y) = eq::trans U64 x (#xor_u64(0u64, y)) y (eq::promote U64 x (#xor_u64(0u64, y)) .hx) (bvrefl(U64, #xor_u64(0u64, y), y));
              absurd(Eq(Bool, true, false), u64::ne_sound x y .e hxy)
          end) .refl(Bool, #eq_u64(#xor_u64(x, y), 0u64))
     | true => fun (.e : Eq(Bool, #eq_u64(x, y), true)) =>
         let .hxy : Eq(U64, x, y) = u64::eq_sound x y .e;
         transport(U64, x, y, hxy, w. Eq(Bool, #eq_u64(#xor_u64(x, w), 0u64), true),
           eq::cong U64 Bool (fun (v : U64) => #eq_u64(v, 0u64)) (#xor_u64(x, x)) 0u64 (bvrefl(U64, #xor_u64(x, x), 0u64)))
     end) .refl(Bool, #eq_u64(x, y))

-- One block of a word-form comparison chain: `((a ⊕ b) | t) == 0` is the
-- eight byte comparisons of `a`, `b` continued by `k`, given `t == 0` is `k`.
def[lemma] word::eq8_or : (a0 : U8) -> (a1 : U8) -> (a2 : U8) -> (a3 : U8) -> (a4 : U8) -> (a5 : U8) -> (a6 : U8) -> (a7 : U8) -> (b0 : U8) -> (b1 : U8) -> (b2 : U8) -> (b3 : U8) -> (b4 : U8) -> (b5 : U8) -> (b6 : U8) -> (b7 : U8) -> (t : U64) -> (k : Bool) -> (.hk : Eq(Bool, #eq_u64(t, 0u64), k)) -> Eq(Bool, #eq_u64(#or_u64(#xor_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int)))), t), 0u64), bool::and (#eq_u8(a0, b0)) (bool::and (#eq_u8(a1, b1)) (bool::and (#eq_u8(a2, b2)) (bool::and (#eq_u8(a3, b3)) (bool::and (#eq_u8(a4, b4)) (bool::and (#eq_u8(a5, b5)) (bool::and (#eq_u8(a6, b6)) (bool::and (#eq_u8(a7, b7)) (k))))))))) :=
  fun (a0 : U8) (a1 : U8) (a2 : U8) (a3 : U8) (a4 : U8) (a5 : U8) (a6 : U8) (a7 : U8) (b0 : U8) (b1 : U8) (b2 : U8) (b3 : U8) (b4 : U8) (b5 : U8) (b6 : U8) (b7 : U8) (t : U64) (k : Bool) (.hk : Eq(Bool, #eq_u64(t, 0u64), k)) =>
    eq::trans Bool (#eq_u64(#or_u64(#xor_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int)))), t), 0u64)) (bool::and (#eq_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int))))) k) (bool::and (#eq_u8(a0, b0)) (bool::and (#eq_u8(a1, b1)) (bool::and (#eq_u8(a2, b2)) (bool::and (#eq_u8(a3, b3)) (bool::and (#eq_u8(a4, b4)) (bool::and (#eq_u8(a5, b5)) (bool::and (#eq_u8(a6, b6)) (bool::and (#eq_u8(a7, b7)) (k)))))))))
      (eq::trans Bool (#eq_u64(#or_u64(#xor_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int)))), t), 0u64)) (bool::and (#eq_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int))))) (#eq_u64(t, 0u64))) (bool::and (#eq_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int))))) k)
        (word::xor_or_eq0 (u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int)))) (u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int)))) t)
        (transport(Bool, #eq_u64(t, 0u64), k, hk, w. Eq(Bool, bool::and (#eq_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int))))) (#eq_u64(t, 0u64)), bool::and (#eq_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int))))) w), refl(Bool, bool::and (#eq_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int))))) (#eq_u64(t, 0u64))))))
      (word::eq8 a0 a1 a2 a3 a4 a5 a6 a7 b0 b1 b2 b3 b4 b5 b6 b7 k)

-- The last block: `(a ⊕ b) == 0` is the eight byte comparisons of `a`, `b`
-- ending the chain (`&& true`).
def[lemma] word::eq8_last : (a0 : U8) -> (a1 : U8) -> (a2 : U8) -> (a3 : U8) -> (a4 : U8) -> (a5 : U8) -> (a6 : U8) -> (a7 : U8) -> (b0 : U8) -> (b1 : U8) -> (b2 : U8) -> (b3 : U8) -> (b4 : U8) -> (b5 : U8) -> (b6 : U8) -> (b7 : U8) -> Eq(Bool, #eq_u64(#xor_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int)))), 0u64), bool::and (#eq_u8(a0, b0)) (bool::and (#eq_u8(a1, b1)) (bool::and (#eq_u8(a2, b2)) (bool::and (#eq_u8(a3, b3)) (bool::and (#eq_u8(a4, b4)) (bool::and (#eq_u8(a5, b5)) (bool::and (#eq_u8(a6, b6)) (bool::and (#eq_u8(a7, b7)) (true))))))))) :=
  fun (a0 : U8) (a1 : U8) (a2 : U8) (a3 : U8) (a4 : U8) (a5 : U8) (a6 : U8) (a7 : U8) (b0 : U8) (b1 : U8) (b2 : U8) (b3 : U8) (b4 : U8) (b5 : U8) (b6 : U8) (b7 : U8) =>
    eq::trans Bool (#eq_u64(#xor_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int)))), 0u64)) (bool::and (#eq_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int))))) true) (bool::and (#eq_u8(a0, b0)) (bool::and (#eq_u8(a1, b1)) (bool::and (#eq_u8(a2, b2)) (bool::and (#eq_u8(a3, b3)) (bool::and (#eq_u8(a4, b4)) (bool::and (#eq_u8(a5, b5)) (bool::and (#eq_u8(a6, b6)) (bool::and (#eq_u8(a7, b7)) (true)))))))))
      (word::xor_eq0 (u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int)))) (u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int)))))
      (word::eq8 a0 a1 a2 a3 a4 a5 a6 a7 b0 b1 b2 b3 b4 b5 b6 b7 true)

-- The same blocks against `seq::eq` itself (what `[u8; 8m] == [u8; 8m]`
-- unfolds to; checking mode keeps `seq::eq` on symbolic bytes folded, so its
-- eight unrollings are `delta` steps).
def[lemma] word::seq_eq8_or : (a0 : U8) -> (a1 : U8) -> (a2 : U8) -> (a3 : U8) -> (a4 : U8) -> (a5 : U8) -> (a6 : U8) -> (a7 : U8) -> (b0 : U8) -> (b1 : U8) -> (b2 : U8) -> (b3 : U8) -> (b4 : U8) -> (b5 : U8) -> (b6 : U8) -> (b7 : U8) -> (xs : List(U8)) -> (ys : List(U8)) -> (t : U64) -> (.hk : Eq(Bool, #eq_u64(t, 0u64), seq::eq U8 (fun (x : U8) (y : U8) => #eq_u8(x, y)) (xs) (ys))) -> Eq(Bool, #eq_u64(#or_u64(#xor_u64(u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, Nil[U8])))))))), refl(Int, 8int))), u64::from_le_bytes (pair(Array U8 8usize, Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, Nil[U8])))))))), refl(Int, 8int)))), t), 0u64), seq::eq U8 (fun (x : U8) (y : U8) => #eq_u8(x, y)) (Cons[U8](a0, Cons[U8](a1, Cons[U8](a2, Cons[U8](a3, Cons[U8](a4, Cons[U8](a5, Cons[U8](a6, Cons[U8](a7, xs))))))))) (Cons[U8](b0, Cons[U8](b1, Cons[U8](b2, Cons[U8](b3, Cons[U8](b4, Cons[U8](b5, Cons[U8](b6, Cons[U8](b7, ys)))))))))) :=
  fun (a0 : U8) (a1 : U8) (a2 : U8) (a3 : U8) (a4 : U8) (a5 : U8) (a6 : U8) (a7 : U8) (b0 : U8) (b1 : U8) (b2 : U8) (b3 : U8) (b4 : U8) (b5 : U8) (b6 : U8) (b7 : U8) (xs : List(U8)) (ys : List(U8)) (t : U64) (.hk : Eq(Bool, #eq_u64(t, 0u64), seq::eq U8 (fun (x : U8) (y : U8) => #eq_u8(x, y)) (xs) (ys))) =>
