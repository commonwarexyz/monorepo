-- `a ≤ b` gives `a >> s ≤ b >> s` (s < w).
def[lemma] bits::shr_mono_u16 : (a : U16) -> (b : U16) -> (s : U32) -> (.h : Eq(Bool, #lt_u32(s, 16u32), true)) -> (.hab : Eq(Bool, #le_u16(a, b), true)) -> Eq(Bool, #le_u16(#shr_u16(a, s; h), #shr_u16(b, s; h)), true) :=
