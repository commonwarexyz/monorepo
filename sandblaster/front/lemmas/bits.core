-- wadd(a, b) is the checked add when that is in its domain.
def[lemma] bits::wadd_exact_usize : (a : Usize) -> (b : Usize) -> (.h : Eq(Bool, #le_int(#iadd(#cast_usize_int(a), #cast_usize_int(b)), 18446744073709551615int), true)) -> Eq(Usize, #wadd_usize(a, b), #add_usize(a, b; h)) :=
  fun (a : Usize) (b : Usize) (.h : Eq(Bool, #le_int(#iadd(#cast_usize_int(a), #cast_usize_int(b)), 18446744073709551615int), true)) =>
    bvrefl(Usize, #wadd_usize(a, b), #add_usize(a, b; h))

-- wsub(a, b) is the checked sub when that is in its domain.
def[lemma] bits::wsub_exact_usize : (a : Usize) -> (b : Usize) -> (.h : Eq(Bool, #le_usize(b, a), true)) -> Eq(Usize, #wsub_usize(a, b), #sub_usize(a, b; h)) :=
  fun (a : Usize) (b : Usize) (.h : Eq(Bool, #le_usize(b, a), true)) =>
    bvrefl(Usize, #wsub_usize(a, b), #sub_usize(a, b; h))

-- wmul(a, b) is the checked mul when that is in its domain.
def[lemma] bits::wmul_exact_usize : (a : Usize) -> (b : Usize) -> (.h : Eq(Bool, #le_int(#imul(#cast_usize_int(a), #cast_usize_int(b)), 18446744073709551615int), true)) -> Eq(Usize, #wmul_usize(a, b), #mul_usize(a, b; h)) :=
  fun (a : Usize) (b : Usize) (.h : Eq(Bool, #le_int(#imul(#cast_usize_int(a), #cast_usize_int(b)), 18446744073709551615int), true)) =>
    bvrefl(Usize, #wmul_usize(a, b), #mul_usize(a, b; h))
