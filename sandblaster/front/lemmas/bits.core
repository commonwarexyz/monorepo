def[lemma] bits::wadd_exact_u64 : (a : U64) -> (b : U64) -> (.h : Eq(Bool, #le_int(#iadd(#cast_u64_int(a), #cast_u64_int(b)), 18446744073709551615int), true)) -> Eq(U64, #wadd_u64(a, b), #add_u64(a, b; h)) :=
  fun (a : U64) (b : U64) (.h : Eq(Bool, #le_int(#iadd(#cast_u64_int(a), #cast_u64_int(b)), 18446744073709551615int), true)) =>
    bvrefl(U64, #wadd_u64(a, b), #add_u64(a, b; h))

-- wsub(a, b) is the checked sub when that is in its domain.
