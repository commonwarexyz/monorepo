-- ---------------------------------------------------------------------------
-- Slices against their views (pe P3, C2): a fact `s == l` (the view of the
-- slice `s` is the sequence `l`) gives `len l = s.len()` (a forward rule).
-- ---------------------------------------------------------------------------

-- A slice's length is its view's length.
def[lemma] slice::view_len : (T : Type) (s : Slice T) (l : List(T)) -> Eq(List(T), fst(snd(s)), l) -> Eq(Int, seq::len T l, #cast_usize_int(fst(s))) :=
  fun (T : Type) (s : Slice T) (l : List(T)) (h_req0 : Eq(List(T), fst(snd(s)), l)) => transport(List(T), fst(snd(s)), l, h_req0, y. Eq(Int, seq::len T y, #cast_usize_int(fst(s))), eq::promote Int (seq::len T fst(snd(s))) #cast_usize_int(fst(s)) .linarith([slice::ok_len T s : Eq(Int, seq::len T fst(snd(s)), #cast_usize_int(fst(s)))]; Eq(Int, seq::len T fst(snd(s)), #cast_usize_int(fst(s))); [-1, 1, 0, 0, 0, 1, 1, 0, 0, 0]))

-- ---------------------------------------------------------------------------
-- Constructor congruence (pe P3, C2): `Some(x) == Some(y)` and
-- `(a, b) == (c, d)` from equal components (backward rules), so a goal
-- that compares an exec reading with a spec reading reaches its payloads.
-- ---------------------------------------------------------------------------

-- Equal payloads give equal options.
def[lemma] option::some_eq : (T : Type) (x : T) (y : T) -> Eq(T, x, y) -> Eq(Option(T), Some[T](x), Some[T](y)) :=
  fun (T : Type) (x : T) (y : T) (h_req0 : Eq(T, x, y)) => transport(T, y, x, eq::sym T x y h_req0, y1. Eq(Option(T), Some[T](y1), Some[T](y)), refl(Option(T), Some[T](y)))

-- Componentwise equal pairs are equal.
def[lemma] option::pair_eq : (T : Type) (U : Type) (a : T) (b : U) (c : T) (d : U) -> Eq(T, a, c) -> Eq(U, b, d) -> Eq(Tuple2(T, U), tuple2[T, U](a, b), tuple2[T, U](c, d)) :=
  fun (T : Type) (U : Type) (a : T) (b : U) (c : T) (d : U) (h_req0 : Eq(T, a, c)) (h_req1 : Eq(U, b, d)) => transport(T, c, a, eq::sym T a c h_req0, y. Eq(Tuple2(T, U), tuple2[T, U](y, b), tuple2[T, U](c, d)), transport(U, d, b, eq::sym U b d h_req1, y. Eq(Tuple2(T, U), tuple2[T, U](c, y), tuple2[T, U](c, d)), refl(Tuple2(T, U), tuple2[T, U](c, d))))
