def[lemma] seq::update_seg_right : (T : Type) -> (b : List(T)) -> (lo : Int) -> (n : Int) -> (r : List(T)) -> (i : Int) -> (x : T)
    -> (.v0 : Eq(Bool, #le_int(0int, lo), true)) -> (.v1 : Eq(Bool, #le_int(0int, n), true))
    -> (.v2 : Eq(Bool, #le_int(#iadd(lo, n), seq::len T b), true)) -> (.hi : Eq(Bool, #le_int(n, i), true))
    -> Eq(List(T), seq::update T (seq::append T (seq::take T (seq::drop T b lo) n) r) i x,
                   seq::append T (seq::take T (seq::drop T b lo) n) (seq::update T r (#isub(i, n)) x)) :=
  fun (T : Type) (b : List(T)) (lo : Int) (n : Int) (r : List(T)) (i : Int) (x : T)
      (.v0 : Eq(Bool, #le_int(0int, lo), true)) (.v1 : Eq(Bool, #le_int(0int, n), true))
      (.v2 : Eq(Bool, #le_int(#iadd(lo, n), seq::len T b), true)) (.hi : Eq(Bool, #le_int(n, i), true)) =>
    let s : List(T) = seq::take T (seq::drop T b lo) n;
    let .ls : Eq(Int, seq::len T s, n) = seq::seg_len T b lo n .v0 .v1 .v2;
    eq::trans (List(T)) (seq::update T (seq::append T s r) i x) (seq::append T (seq::update T s i x) (seq::update T r (#isub(i, seq::len T s)) x))
      (seq::append T s (seq::update T r (#isub(i, n)) x))
      (seq::update_append T s r i x)
      (eq::trans (List(T)) (seq::append T (seq::update T s i x) (seq::update T r (#isub(i, seq::len T s)) x))
         (seq::append T s (seq::update T r (#isub(i, seq::len T s)) x))
         (seq::append T s (seq::update T r (#isub(i, n)) x))
         (eq::cong (List(T)) (List(T)) (fun (z : List(T)) => seq::append T z (seq::update T r (#isub(i, seq::len T s)) x)) (seq::update T s i x) s
            (seq::update_oob T s i x .linarith([ls : Eq(Int, seq::len T s, n), hi : Eq(Bool, #le_int(n, i), true)]; Eq(Bool, #le_int(seq::len T s, i), true); [])))
         (eq::cong Int (List(T)) (fun (j : Int) => seq::append T s (seq::update T r j x)) (#isub(i, seq::len T s)) (#isub(i, n))
            (eq::promote Int (#isub(i, seq::len T s)) (#isub(i, n)) .linarith([ls : Eq(Int, seq::len T s, n)]; Eq(Int, #isub(i, seq::len T s), #isub(i, n)); []))))

def[lemma] seq::update_rep_right : (T : Type) -> (n : Int) -> (z : T) -> (r : List(T)) -> (i : Int) -> (x : T)
    -> (.v1 : Eq(Bool, #le_int(0int, n), true)) -> (.hi : Eq(Bool, #le_int(n, i), true))
    -> Eq(List(T), seq::update T (seq::append T (seq::replicate T n z) r) i x,
                   seq::append T (seq::replicate T n z) (seq::update T r (#isub(i, n)) x)) :=
  fun (T : Type) (n : Int) (z : T) (r : List(T)) (i : Int) (x : T) (.v1 : Eq(Bool, #le_int(0int, n), true)) (.hi : Eq(Bool, #le_int(n, i), true)) =>
    let s : List(T) = seq::replicate T n z;
    let .ls : Eq(Int, seq::len T s, n) = seq::len_replicate T n z .v1;
    eq::trans (List(T)) (seq::update T (seq::append T s r) i x) (seq::append T (seq::update T s i x) (seq::update T r (#isub(i, seq::len T s)) x))
      (seq::append T s (seq::update T r (#isub(i, n)) x))
      (seq::update_append T s r i x)
      (eq::trans (List(T)) (seq::append T (seq::update T s i x) (seq::update T r (#isub(i, seq::len T s)) x))
         (seq::append T s (seq::update T r (#isub(i, seq::len T s)) x))
         (seq::append T s (seq::update T r (#isub(i, n)) x))
         (eq::cong (List(T)) (List(T)) (fun (w : List(T)) => seq::append T w (seq::update T r (#isub(i, seq::len T s)) x)) (seq::update T s i x) s
            (seq::update_oob T s i x .linarith([ls : Eq(Int, seq::len T s, n), hi : Eq(Bool, #le_int(n, i), true)]; Eq(Bool, #le_int(seq::len T s, i), true); [])))
         (eq::cong Int (List(T)) (fun (j : Int) => seq::append T s (seq::update T r j x)) (#isub(i, seq::len T s)) (#isub(i, n))
            (eq::promote Int (#isub(i, seq::len T s)) (#isub(i, n)) .linarith([ls : Eq(Int, seq::len T s, n)]; Eq(Int, #isub(i, seq::len T s), #isub(i, n)); []))))

def[lemma] seq::update_rep_mid : (T : Type) -> (n : Int) -> (z : T) -> (r : List(T)) -> (i : Int) -> (x : T)
    -> (.h0 : Eq(Bool, #le_int(0int, i), true)) -> (.h1 : Eq(Bool, #lt_int(i, n), true))
    -> Eq(List(T), seq::update T (seq::append T (seq::replicate T n z) r) i x,
                   seq::append T (seq::replicate T i z) (Cons[T](x, seq::append T (seq::replicate T (#isub(#isub(n, i), 1int)) z) r))) :=
  fun (T : Type) (n : Int) (z : T) (r : List(T)) (i : Int) (x : T) (.h0 : Eq(Bool, #le_int(0int, i), true)) (.h1 : Eq(Bool, #lt_int(i, n), true)) =>
    let s : List(T) = seq::replicate T n z;
    let .ls : Eq(Int, seq::len T s, n) =
      seq::len_replicate T n z .linarith([h0 : Eq(Bool, #le_int(0int, i), true), h1 : Eq(Bool, #lt_int(i, n), true)]; Eq(Bool, #le_int(0int, n), true); []);
    eq::trans (List(T)) (seq::update T (seq::append T s r) i x) (seq::append T (seq::update T s i x) (seq::update T r (#isub(i, seq::len T s)) x))
      (seq::append T (seq::replicate T i z) (Cons[T](x, seq::append T (seq::replicate T (#isub(#isub(n, i), 1int)) z) r)))
      (seq::update_append T s r i x)
      (eq::trans (List(T)) (seq::append T (seq::update T s i x) (seq::update T r (#isub(i, seq::len T s)) x))
         (seq::append T (seq::update T s i x) r)
         (seq::append T (seq::replicate T i z) (Cons[T](x, seq::append T (seq::replicate T (#isub(#isub(n, i), 1int)) z) r)))
         (eq::cong (List(T)) (List(T)) (fun (w : List(T)) => seq::append T (seq::update T s i x) w) (seq::update T r (#isub(i, seq::len T s)) x) r
            (seq::update_neg T r (#isub(i, seq::len T s)) x
               .linarith([ls : Eq(Int, seq::len T s, n), h1 : Eq(Bool, #lt_int(i, n), true)]; Eq(Bool, #lt_int(#isub(i, seq::len T s), 0int), true); [])))
         (eq::trans (List(T)) (seq::append T (seq::update T s i x) r)
            (seq::append T (seq::append T (seq::replicate T i z) (Cons[T](x, seq::replicate T (#isub(#isub(n, i), 1int)) z))) r)
            (seq::append T (seq::replicate T i z) (Cons[T](x, seq::append T (seq::replicate T (#isub(#isub(n, i), 1int)) z) r)))
            (eq::cong (List(T)) (List(T)) (fun (w : List(T)) => seq::append T w r) (seq::update T s i x)
               (seq::append T (seq::replicate T i z) (Cons[T](x, seq::replicate T (#isub(#isub(n, i), 1int)) z)))
               (seq::update_replicate T n z i x .h0 .h1))
            (seq::append_assoc T (seq::replicate T i z) (Cons[T](x, seq::replicate T (#isub(#isub(n, i), 1int)) z)) r)))

-- Reading inside / after a piece.
def[lemma] seq::index_seg_in : (T : Type) -> (b : List(T)) -> (lo : Int) -> (n : Int) -> (r : List(T)) -> (i : Int)
    -> (.v0 : Eq(Bool, #le_int(0int, lo), true)) -> (.v1 : Eq(Bool, #le_int(0int, n), true))
    -> (.v2 : Eq(Bool, #le_int(#iadd(lo, n), seq::len T b), true))
    -> (.h0 : Eq(Bool, #le_int(0int, i), true)) -> (.h1 : Eq(Bool, #lt_int(i, n), true))
    -> (.h2 : Eq(Bool, #lt_int(i, seq::len T (seq::append T (seq::take T (seq::drop T b lo) n) r)), true))
    -> (.g0 : Eq(Bool, #le_int(0int, #iadd(lo, i)), true)) -> (.g1 : Eq(Bool, #lt_int(#iadd(lo, i), seq::len T b), true))
    -> Eq(T, seq::index T (seq::append T (seq::take T (seq::drop T b lo) n) r) i .h0 .h2, seq::index T b (#iadd(lo, i)) .g0 .g1) :=
  fun (T : Type) (b : List(T)) (lo : Int) (n : Int) (r : List(T)) (i : Int)
      (.v0 : Eq(Bool, #le_int(0int, lo), true)) (.v1 : Eq(Bool, #le_int(0int, n), true))
      (.v2 : Eq(Bool, #le_int(#iadd(lo, n), seq::len T b), true))
      (.h0 : Eq(Bool, #le_int(0int, i), true)) (.h1 : Eq(Bool, #lt_int(i, n), true))
      (.h2 : Eq(Bool, #lt_int(i, seq::len T (seq::append T (seq::take T (seq::drop T b lo) n) r)), true))
      (.g0 : Eq(Bool, #le_int(0int, #iadd(lo, i)), true)) (.g1 : Eq(Bool, #lt_int(#iadd(lo, i), seq::len T b), true)) =>
    let s : List(T) = seq::take T (seq::drop T b lo) n;
    let .ls : Eq(Int, seq::len T s, n) = seq::seg_len T b lo n .v0 .v1 .v2;
    let .ld : Eq(Int, seq::len T (seq::drop T b lo), #isub(seq::len T b, lo)) =
      seq::len_drop T b lo (eq::promote Bool (#le_int(0int, lo)) true .v0)
        (eq::promote Bool (#le_int(lo, seq::len T b)) true
           .linarith([v1 : Eq(Bool, #le_int(0int, n), true), v2 : Eq(Bool, #le_int(#iadd(lo, n), seq::len T b), true)]; Eq(Bool, #le_int(lo, seq::len T b), true); []));
    let .p1 : Eq(Bool, #lt_int(i, seq::len T s), true) =
      linarith([ls : Eq(Int, seq::len T s, n), h1 : Eq(Bool, #lt_int(i, n), true)]; Eq(Bool, #lt_int(i, seq::len T s), true); []);
    let .p2 : Eq(Bool, #lt_int(i, seq::len T (seq::drop T b lo)), true) =
      linarith([ld : Eq(Int, seq::len T (seq::drop T b lo), #isub(seq::len T b, lo)), h1 : Eq(Bool, #lt_int(i, n), true),
                v2 : Eq(Bool, #le_int(#iadd(lo, n), seq::len T b), true)]; Eq(Bool, #lt_int(i, seq::len T (seq::drop T b lo)), true); []);
    eq::trans T (seq::index T (seq::append T s r) i .h0 .h2) (seq::index T s i .h0 .p1) (seq::index T b (#iadd(lo, i)) .g0 .g1)
      (seq::index_append_l T s r i .h0 .p1 .h2)
      (eq::trans T (seq::index T s i .h0 .p1) (seq::index T (seq::drop T b lo) i .h0 .p2) (seq::index T b (#iadd(lo, i)) .g0 .g1)
         (seq::index_take_lt T (seq::drop T b lo) n i .h0 .h1 .p2 .p1)
         (seq::index_drop T b lo i .v0 .h0 .p2 .g0 .g1))

def[lemma] seq::index_seg_after : (T : Type) -> (b : List(T)) -> (lo : Int) -> (n : Int) -> (r : List(T)) -> (i : Int)
    -> (.v0 : Eq(Bool, #le_int(0int, lo), true)) -> (.v1 : Eq(Bool, #le_int(0int, n), true))
    -> (.v2 : Eq(Bool, #le_int(#iadd(lo, n), seq::len T b), true))
    -> (.h0 : Eq(Bool, #le_int(0int, i), true)) -> (.h1 : Eq(Bool, #le_int(n, i), true))
    -> (.h2 : Eq(Bool, #lt_int(i, seq::len T (seq::append T (seq::take T (seq::drop T b lo) n) r)), true))
    -> (.g0 : Eq(Bool, #le_int(0int, #isub(i, n)), true)) -> (.g1 : Eq(Bool, #lt_int(#isub(i, n), seq::len T r), true))
    -> Eq(T, seq::index T (seq::append T (seq::take T (seq::drop T b lo) n) r) i .h0 .h2, seq::index T r (#isub(i, n)) .g0 .g1) :=
  fun (T : Type) (b : List(T)) (lo : Int) (n : Int) (r : List(T)) (i : Int)
      (.v0 : Eq(Bool, #le_int(0int, lo), true)) (.v1 : Eq(Bool, #le_int(0int, n), true))
      (.v2 : Eq(Bool, #le_int(#iadd(lo, n), seq::len T b), true))
      (.h0 : Eq(Bool, #le_int(0int, i), true)) (.h1 : Eq(Bool, #le_int(n, i), true))
      (.h2 : Eq(Bool, #lt_int(i, seq::len T (seq::append T (seq::take T (seq::drop T b lo) n) r)), true))
      (.g0 : Eq(Bool, #le_int(0int, #isub(i, n)), true)) (.g1 : Eq(Bool, #lt_int(#isub(i, n), seq::len T r), true)) =>
    let s : List(T) = seq::take T (seq::drop T b lo) n;
    let .ls : Eq(Int, seq::len T s, n) = seq::seg_len T b lo n .v0 .v1 .v2;
    let .q1 : Eq(Bool, #le_int(seq::len T s, i), true) =
      linarith([ls : Eq(Int, seq::len T s, n), h1 : Eq(Bool, #le_int(n, i), true)]; Eq(Bool, #le_int(seq::len T s, i), true); []);
    let .q2 : Eq(Bool, #le_int(0int, #isub(i, seq::len T s)), true) =
      linarith([ls : Eq(Int, seq::len T s, n), h1 : Eq(Bool, #le_int(n, i), true)]; Eq(Bool, #le_int(0int, #isub(i, seq::len T s)), true); []);
    let .q3 : Eq(Bool, #lt_int(#isub(i, seq::len T s), seq::len T r), true) =
      linarith([ls : Eq(Int, seq::len T s, n), g1 : Eq(Bool, #lt_int(#isub(i, n), seq::len T r), true)]; Eq(Bool, #lt_int(#isub(i, seq::len T s), seq::len T r), true); []);
    eq::trans T (seq::index T (seq::append T s r) i .h0 .h2) (seq::index T r (#isub(i, seq::len T s)) .q2 .q3) (seq::index T r (#isub(i, n)) .g0 .g1)
      (seq::index_append_r T s r i .h0 .h2 .q1 .q2 .q3)
      (seq::index_at_eq T r (#isub(i, seq::len T s)) (#isub(i, n)) .q2 .q3 .g0 .g1
         .linarith([ls : Eq(Int, seq::len T s, n)]; Eq(Int, #isub(i, seq::len T s), #isub(i, n)); []))

def[lemma] seq::index_rep_in : (T : Type) -> (n : Int) -> (v : T) -> (r : List(T)) -> (i : Int)
    -> (.h0 : Eq(Bool, #le_int(0int, i), true)) -> (.h1 : Eq(Bool, #lt_int(i, n), true))
    -> (.h2 : Eq(Bool, #lt_int(i, seq::len T (seq::append T (seq::replicate T n v) r)), true))
    -> Eq(T, seq::index T (seq::append T (seq::replicate T n v) r) i .h0 .h2, v) :=
  fun (T : Type) (n : Int) (v : T) (r : List(T)) (i : Int)
      (.h0 : Eq(Bool, #le_int(0int, i), true)) (.h1 : Eq(Bool, #lt_int(i, n), true))
      (.h2 : Eq(Bool, #lt_int(i, seq::len T (seq::append T (seq::replicate T n v) r)), true)) =>
    let s : List(T) = seq::replicate T n v;
    let .ls : Eq(Int, seq::len T s, n) =
      seq::len_replicate T n v .linarith([h0 : Eq(Bool, #le_int(0int, i), true), h1 : Eq(Bool, #lt_int(i, n), true)]; Eq(Bool, #le_int(0int, n), true); []);
    let .p1 : Eq(Bool, #lt_int(i, seq::len T s), true) =
      linarith([ls : Eq(Int, seq::len T s, n), h1 : Eq(Bool, #lt_int(i, n), true)]; Eq(Bool, #lt_int(i, seq::len T s), true); []);
    eq::trans T (seq::index T (seq::append T s r) i .h0 .h2) (seq::index T s i .h0 .p1) v
      (seq::index_append_l T s r i .h0 .p1 .h2)
      (seq::index_replicate T n v i .h0 .h1 .p1)

def[lemma] seq::index_rep_after : (T : Type) -> (n : Int) -> (v : T) -> (r : List(T)) -> (i : Int)
    -> (.v1 : Eq(Bool, #le_int(0int, n), true))
    -> (.h0 : Eq(Bool, #le_int(0int, i), true)) -> (.h1 : Eq(Bool, #le_int(n, i), true))
    -> (.h2 : Eq(Bool, #lt_int(i, seq::len T (seq::append T (seq::replicate T n v) r)), true))
    -> (.g0 : Eq(Bool, #le_int(0int, #isub(i, n)), true)) -> (.g1 : Eq(Bool, #lt_int(#isub(i, n), seq::len T r), true))
    -> Eq(T, seq::index T (seq::append T (seq::replicate T n v) r) i .h0 .h2, seq::index T r (#isub(i, n)) .g0 .g1) :=
  fun (T : Type) (n : Int) (v : T) (r : List(T)) (i : Int)
      (.v1 : Eq(Bool, #le_int(0int, n), true))
      (.h0 : Eq(Bool, #le_int(0int, i), true)) (.h1 : Eq(Bool, #le_int(n, i), true))
      (.h2 : Eq(Bool, #lt_int(i, seq::len T (seq::append T (seq::replicate T n v) r)), true))
      (.g0 : Eq(Bool, #le_int(0int, #isub(i, n)), true)) (.g1 : Eq(Bool, #lt_int(#isub(i, n), seq::len T r), true)) =>
    let s : List(T) = seq::replicate T n v;
    let .ls : Eq(Int, seq::len T s, n) = seq::len_replicate T n v .v1;
    let .q1 : Eq(Bool, #le_int(seq::len T s, i), true) =
      linarith([ls : Eq(Int, seq::len T s, n), h1 : Eq(Bool, #le_int(n, i), true)]; Eq(Bool, #le_int(seq::len T s, i), true); []);
    let .q2 : Eq(Bool, #le_int(0int, #isub(i, seq::len T s)), true) =
      linarith([ls : Eq(Int, seq::len T s, n), h1 : Eq(Bool, #le_int(n, i), true)]; Eq(Bool, #le_int(0int, #isub(i, seq::len T s)), true); []);
    let .q3 : Eq(Bool, #lt_int(#isub(i, seq::len T s), seq::len T r), true) =
      linarith([ls : Eq(Int, seq::len T s, n), g1 : Eq(Bool, #lt_int(#isub(i, n), seq::len T r), true)]; Eq(Bool, #lt_int(#isub(i, seq::len T s), seq::len T r), true); []);
    eq::trans T (seq::index T (seq::append T s r) i .h0 .h2) (seq::index T r (#isub(i, seq::len T s)) .q2 .q3) (seq::index T r (#isub(i, n)) .g0 .g1)
      (seq::index_append_r T s r i .h0 .h2 .q1 .q2 .q3)
      (seq::index_at_eq T r (#isub(i, seq::len T s)) (#isub(i, n)) .q2 .q3 .g0 .g1
         .linarith([ls : Eq(Int, seq::len T s, n)]; Eq(Int, #isub(i, seq::len T s), #isub(i, n)); []))

-- ---------------------------------------------------------------------------
-- Folds and scans (the fold templates SP1/SP2 and the scan demand of Σ3).
-- `seq::foldl` / `seq::foldr` / `seq::scanl` are the list-level meanings of
-- a consumer loop; a consumer is related to them by its own lemma, and the
-- lemmas below split them over the pieces of a normal form.
-- ---------------------------------------------------------------------------

def[spec] seq::foldl : (T : Type) -> (A : Type) -> (f : A -> T -> A) -> (z : A) -> (l : List(T)) -> A :=
  fun (T : Type) (A : Type) (f : A -> T -> A) (z : A) (l : List(T)) =>
    match l : List(T) as _ return A with
    | Nil => z
    | Cons(x, t) => rec(T, A, f, f z x, t)
    end
  structural 4

def[spec] seq::foldr : (T : Type) -> (A : Type) -> (f : T -> A -> A) -> (z : A) -> (l : List(T)) -> A :=
  fun (T : Type) (A : Type) (f : T -> A -> A) (z : A) (l : List(T)) =>
    match l : List(T) as _ return A with
    | Nil => z
    | Cons(x, t) => f x (rec(T, A, f, z, t))
    end
  structural 4

-- The running values of `foldl`, the initial one first: `len l + 1` values.
def[spec] seq::scanl : (T : Type) -> (A : Type) -> (f : A -> T -> A) -> (z : A) -> (l : List(T)) -> List(A) :=
  fun (T : Type) (A : Type) (f : A -> T -> A) (z : A) (l : List(T)) =>
    match l : List(T) as _ return List(A) with
    | Nil => Cons[A](z, Nil[A])
    | Cons(x, t) => Cons[A](z, rec(T, A, f, f z x, t))
    end
  structural 4

-- SP1: a left fold over `xs ++ ys` folds `xs`, then `ys` from there.
def[lemma] seq::foldl_append : (T : Type) -> (A : Type) -> (f : A -> T -> A) -> (z : A) -> (xs : List(T)) -> (ys : List(T))
    -> Eq(A, seq::foldl T A f z (seq::append T xs ys), seq::foldl T A f (seq::foldl T A f z xs) ys) :=
  fun (T : Type) (A : Type) (f : A -> T -> A) (z : A) (xs : List(T)) (ys : List(T)) =>
    match xs : List(T) as y return Eq(A, seq::foldl T A f z (seq::append T y ys), seq::foldl T A f (seq::foldl T A f z y) ys) with
    | Nil => refl(A, seq::foldl T A f z ys)
    | Cons(x, t) => rec(T, A, f, f z x, t, ys)
    end
  structural 4

-- SP2: a right fold over `xs ++ ys` folds `ys` first, then `xs` onto it.
def[lemma] seq::foldr_append : (T : Type) -> (A : Type) -> (f : T -> A -> A) -> (z : A) -> (xs : List(T)) -> (ys : List(T))
    -> Eq(A, seq::foldr T A f z (seq::append T xs ys), seq::foldr T A f (seq::foldr T A f z ys) xs) :=
  fun (T : Type) (A : Type) (f : T -> A -> A) (z : A) (xs : List(T)) (ys : List(T)) =>
    match xs : List(T) as y return Eq(A, seq::foldr T A f z (seq::append T y ys), seq::foldr T A f (seq::foldr T A f z ys) y) with
    | Nil => refl(A, seq::foldr T A f z ys)
    | Cons(x, t) =>
        eq::cong A A (fun (r : A) => f x r)
          (seq::foldr T A f z (seq::append T t ys)) (seq::foldr T A f (seq::foldr T A f z ys) t) (rec(T, A, f, z, t, ys))
    end
  structural 4

def[lemma] seq::len_scanl : (T : Type) -> (A : Type) -> (f : A -> T -> A) -> (z : A) -> (l : List(T))
    -> Eq(Int, seq::len A (seq::scanl T A f z l), #iadd(seq::len T l, 1int)) :=
  fun (T : Type) (A : Type) (f : A -> T -> A) (z : A) (l : List(T)) =>
    match l : List(T) as y return Eq(Int, seq::len A (seq::scanl T A f z y), #iadd(seq::len T y, 1int)) with
    | Nil => refl(Int, 1int)
    | Cons(x, t) =>
        linarith([rec(T, A, f, f z x, t) : Eq(Int, seq::len A (seq::scanl T A f (f z x) t), #iadd(seq::len T t, 1int))];
                 Eq(Int, seq::len A (Cons[A](z, seq::scanl T A f (f z x) t)), #iadd(seq::len T (Cons[T](x, t)), 1int)); [])
    end
  structural 4

-- The demand of a scanned table: its `i`-th entry is the fold of the first
-- `i` elements.
def[lemma] seq::index_scanl : (T : Type) -> (A : Type) -> (f : A -> T -> A) -> (z : A) -> (l : List(T)) -> (i : Int)
    -> (.h0 : Eq(Bool, #le_int(0int, i), true)) -> (.h1 : Eq(Bool, #lt_int(i, seq::len A (seq::scanl T A f z l)), true))
    -> Eq(A, seq::index A (seq::scanl T A f z l) i .h0 .h1, seq::foldl T A f z (seq::take T l i)) :=
  fun (T : Type) (A : Type) (f : A -> T -> A) (z : A) (l : List(T)) (i : Int)
      (.h0 : Eq(Bool, #le_int(0int, i), true)) (.h1 : Eq(Bool, #lt_int(i, seq::len A (seq::scanl T A f z l)), true)) =>
    (match l : List(T) as y
       return (.hy : Eq(Bool, #lt_int(i, seq::len A (seq::scanl T A f z y)), true))
         -> Eq(A, seq::index A (seq::scanl T A f z y) i .h0 .hy, seq::foldl T A f z (seq::take T y i)) with
     | Nil => fun (.hy : Eq(Bool, #lt_int(i, seq::len A (seq::scanl T A f z Nil[T])), true)) =>
         seq::index_cons_zero A z Nil[A] i .h0 .hy
           .linarith([h0 : Eq(Bool, #le_int(0int, i), true), hy : Eq(Bool, #lt_int(i, 1int), true)]; Eq(Bool, #le_int(i, 0int), true); [])
     | Cons(x, t) => fun (.hy : Eq(Bool, #lt_int(i, seq::len A (seq::scanl T A f z (Cons[T](x, t)))), true)) =>
         let s : List(A) = seq::scanl T A f (f z x) t;
         if #le_int(i, 0int) as .c
           return Eq(A, seq::index A (Cons[A](z, s)) i .h0 .hy, seq::foldl T A f z (seq::take T (Cons[T](x, t)) i))
         then
           eq::trans A (seq::index A (Cons[A](z, s)) i .h0 .hy) z (seq::foldl T A f z (seq::take T (Cons[T](x, t)) i))
             (seq::index_cons_zero A z s i .h0 .hy .c)
             (eq::sym A (seq::foldl T A f z (seq::take T (Cons[T](x, t)) i)) z
               (eq::cong (List(T)) A (fun (r : List(T)) => seq::foldl T A f z r)
                  (seq::take T (Cons[T](x, t)) i) Nil[T] (seq::take_cons_nonpos T x t i .c)))
         else
           let .g0 : Eq(Bool, #le_int(0int, #isub(i, 1int)), true) =
             linarith([c : Eq(Bool, #le_int(i, 0int), false)]; Eq(Bool, #le_int(0int, #isub(i, 1int)), true); []);
           let .g1 : Eq(Bool, #lt_int(#isub(i, 1int), seq::len A s), true) =
             linarith([hy : Eq(Bool, #lt_int(i, #iadd(seq::len A s, 1int)), true)]; Eq(Bool, #lt_int(#isub(i, 1int), seq::len A s), true); []);
           eq::trans A (seq::index A (Cons[A](z, s)) i .h0 .hy) (seq::index A s (#isub(i, 1int)) .g0 .g1)
             (seq::foldl T A f z (seq::take T (Cons[T](x, t)) i))
             (seq::index_cons_succ A z s i .h0 .hy .c)
             (eq::trans A (seq::index A s (#isub(i, 1int)) .g0 .g1) (seq::foldl T A f (f z x) (seq::take T t (#isub(i, 1int))))
                (seq::foldl T A f z (seq::take T (Cons[T](x, t)) i))
                (rec(T, A, f, f z x, t, #isub(i, 1int), .g0, .g1))
                (eq::sym A (seq::foldl T A f z (seq::take T (Cons[T](x, t)) i)) (seq::foldl T A f (f z x) (seq::take T t (#isub(i, 1int))))
                  (eq::cong (List(T)) A (fun (r : List(T)) => seq::foldl T A f z r)
                     (seq::take T (Cons[T](x, t)) i) (Cons[T](x, seq::take T t (#isub(i, 1int)))) (seq::take_cons_pos T x t i .c))))
     end) .h1
  structural 4
