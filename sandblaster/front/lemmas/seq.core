    let s : List(T) = seq::take T (seq::drop T b lo) n;
    let .ls : Eq(Int, seq::len T s, n) = seq::seg_len T b lo n .v0 .v1 .v2;
    eq::trans (List(T)) (seq::take T (seq::append T s r) k) (seq::append T (seq::take T s k) (seq::take T r (#isub(k, seq::len T s))))
