            (seq::take_all T s k .linarith([ls : Eq(Int, seq::len T s, n), hk : Eq(Bool, #le_int(n, k), true)]; Eq(Bool, #le_int(seq::len T s, k), true); [])))
         (eq::cong Int (List(T)) (fun (j : Int) => seq::append T s (seq::take T r j)) (#isub(k, seq::len T s)) (#isub(k, n))
