  fun (T : Type) (n : Int) (v : T) (r : List(T)) (k : Int) (.k0 : Eq(Bool, #le_int(0int, k), true)) (.k1 : Eq(Bool, #le_int(k, n), true)) =>
    let s : List(T) = seq::replicate T n v;
    let .ls : Eq(Int, seq::len T s, n) =
      seq::len_replicate T n v .linarith([k0 : Eq(Bool, #le_int(0int, k), true), k1 : Eq(Bool, #le_int(k, n), true)]; Eq(Bool, #le_int(0int, n), true); []);
    eq::trans (List(T)) (seq::drop T (seq::append T s r) k) (seq::append T (seq::drop T s k) (seq::drop T r (#isub(k, seq::len T s))))
      (seq::append T (seq::replicate T (#isub(n, k)) v) r)
