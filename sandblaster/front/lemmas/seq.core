         (eq::cong (List(T)) (List(T)) (fun (z : List(T)) => seq::append T z r) (seq::drop T s k) (seq::take T (seq::drop T b (#iadd(lo, k))) (#isub(n, k)))
            (eq::trans (List(T)) (seq::drop T s k) (seq::take T (seq::drop T (seq::drop T b lo) k) (#isub(n, k)))
