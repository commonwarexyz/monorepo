-- The chunk-count equation for a literal chunk size.
%forn N in 1 2 4 8 16 32 64 128 256
def[lemma] seq::chunks_len_$N : (T : Type) -> (.hN : Eq(Bool, #lt_usize(0usize, $Nusize), true)) -> (l : List(T))
