            pair(Sigma (rs : List(T)), .Eq(Bool, #le_int(seq::len T rs, seq::len T l), true), fst(seq::chunks_rest_go T N .hN (seq::drop T l (#cast_usize_int(N))) (#isub(seq::len T l, #cast_usize_int(N))) .(eq::sym Int (seq::len T (seq::drop T l (#cast_usize_int(N)))) (#isub(seq::len T l, #cast_usize_int(N))) (seq::len_drop T l (#cast_usize_int(N)) (linarith([]; Eq(Bool, #le_int(0int, #cast_usize_int(N)), true); [1, 1, 0])) (linarith([c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), false)]; Eq(Bool, #le_int(#cast_usize_int(N), seq::len T l), true); [1, 1, 0, 0, 0]))))),
              linarith([snd(seq::chunks_rest_go T N .hN (seq::drop T l (#cast_usize_int(N))) (#isub(seq::len T l, #cast_usize_int(N))) .(eq::sym Int (seq::len T (seq::drop T l (#cast_usize_int(N)))) (#isub(seq::len T l, #cast_usize_int(N))) (seq::len_drop T l (#cast_usize_int(N)) (linarith([]; Eq(Bool, #le_int(0int, #cast_usize_int(N)), true); [1, 1, 0])) (linarith([c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), false)]; Eq(Bool, #le_int(#cast_usize_int(N), seq::len T l), true); [1, 1, 0, 0, 0]))))) : Eq(Bool, #le_int(seq::len T fst(seq::chunks_rest_go T N .hN (seq::drop T l (#cast_usize_int(N))) (#isub(seq::len T l, #cast_usize_int(N))) .(eq::sym Int (seq::len T (seq::drop T l (#cast_usize_int(N)))) (#isub(seq::len T l, #cast_usize_int(N))) (seq::len_drop T l (#cast_usize_int(N)) (linarith([]; Eq(Bool, #le_int(0int, #cast_usize_int(N)), true); [1, 1, 0])) (linarith([c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), false)]; Eq(Bool, #le_int(#cast_usize_int(N), seq::len T l), true); [1, 1, 0, 0, 0]))))), seq::len T (seq::drop T l (#cast_usize_int(N)))), true),
