    let mr : (z : Bool) -> (.c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), z)) -> Sigma (rs : List(T)), .Eq(Bool, #le_int(seq::len T rs, seq::len T l), true) =
