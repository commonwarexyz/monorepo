-- sandblaster prelude lemmas: `as_chunks` (DESIGN.md §3.4 method fact
-- `let (c, r) = s.as_chunks::<N>()` ⇒ `c.len()·N + r.len() == s.len() ∧
-- r.len() < N`).
--
-- `c.len()·N` is linear only for a literal `N` (distributivity of `imul` on
-- symbolic values is not derivable in the kernel), so the fact is proved
-- once per chunk size by a measure induction that mirrors
-- `seq::chunks_c`; the induction uses the generic one-step lemmas below
-- (each unfolds the helper with `delta`, then reduces the exposed test
-- along the known comparison). The `%forn N in …` block is expanded by
-- `sandblaster_front::auto::lemmas::load` (`$N` is the literal chunk size).
--
-- Checked, untrusted.

-- The chunking loops do not depend on the length equation they carry:
-- started at any `n = len l` they are `seq::chunks_c` / `seq::chunks_rest_c`
-- (by `transport` along `hn`; the equation is irrelevant).
def[lemma] seq::chunks_go_irrel : (T : Type) -> (N : Usize) -> (.hN : Eq(Bool, #lt_usize(0usize, N), true)) -> (l : List(T))
    -> (n : Int) -> (.hn : Eq(Int, n, seq::len T l))
    -> Eq(Sigma (cs : List(Array T N)), .Eq(Bool, #le_int(seq::len (Array T N) cs, seq::len T l), true), seq::chunks_go T N .hN l n .hn, seq::chunks_c T N .hN l) :=
  fun (T : Type) (N : Usize) (.hN : Eq(Bool, #lt_usize(0usize, N), true)) (l : List(T)) (n : Int) (.hn : Eq(Int, n, seq::len T l)) =>
    (transport(Int, seq::len T l, n, eq::sym Int n (seq::len T l) hn,
       z. (.h : Eq(Int, z, seq::len T l)) -> Eq(Sigma (cs : List(Array T N)), .Eq(Bool, #le_int(seq::len (Array T N) cs, seq::len T l), true), seq::chunks_go T N .hN l z .h, seq::chunks_c T N .hN l),
       fun (.h : Eq(Int, seq::len T l, seq::len T l)) => refl(Sigma (cs : List(Array T N)), .Eq(Bool, #le_int(seq::len (Array T N) cs, seq::len T l), true), seq::chunks_c T N .hN l))) .hn

def[lemma] seq::chunks_rest_go_irrel : (T : Type) -> (N : Usize) -> (.hN : Eq(Bool, #lt_usize(0usize, N), true)) -> (l : List(T))
    -> (n : Int) -> (.hn : Eq(Int, n, seq::len T l))
    -> Eq(Sigma (rs : List(T)), .Eq(Bool, #le_int(seq::len T rs, seq::len T l), true), seq::chunks_rest_go T N .hN l n .hn, seq::chunks_rest_c T N .hN l) :=
  fun (T : Type) (N : Usize) (.hN : Eq(Bool, #lt_usize(0usize, N), true)) (l : List(T)) (n : Int) (.hn : Eq(Int, n, seq::len T l)) =>
    (transport(Int, seq::len T l, n, eq::sym Int n (seq::len T l) hn,
       z. (.h : Eq(Int, z, seq::len T l)) -> Eq(Sigma (rs : List(T)), .Eq(Bool, #le_int(seq::len T rs, seq::len T l), true), seq::chunks_rest_go T N .hN l z .h, seq::chunks_rest_c T N .hN l),
       fun (.h : Eq(Int, seq::len T l, seq::len T l)) => refl(Sigma (rs : List(T)), .Eq(Bool, #le_int(seq::len T rs, seq::len T l), true), seq::chunks_rest_c T N .hN l))) .hn

-- `len l < N`: no chunks, the whole list is the rest. (Each lemma unfolds
-- the loop at `n = len l` with `delta` and reduces the exposed test along
-- the known comparison; the recursive call of the loop is related to
-- `chunks_c` of the rest by `seq::chunks_go_irrel`.)
def[lemma] seq::chunks_c_small : (T : Type) -> (N : Usize) -> (.hN : Eq(Bool, #lt_usize(0usize, N), true)) -> (l : List(T))
    -> (.c : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), true)) -> Eq(List(Array T N), fst((seq::chunks_c T N .hN l)), Nil[Array T N]) :=
  fun (T : Type) (N : Usize) (.hN : Eq(Bool, #lt_usize(0usize, N), true)) (l : List(T)) (.c : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), true)) =>
    let mc : (z : Bool) -> (.c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), z)) -> Sigma (cs : List(Array T N)), .Eq(Bool, #le_int(seq::len (Array T N) cs, seq::len T l), true) =
      fun (z : Bool) =>
        match z : Bool as b return (.c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), b)) -> Sigma (cs : List(Array T N)), .Eq(Bool, #le_int(seq::len (Array T N) cs, seq::len T l), true) with
        | false => fun (.c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), false)) =>
            pair(Sigma (cs : List(Array T N)), .Eq(Bool, #le_int(seq::len (Array T N) cs, seq::len T l), true),
              Cons[Array T N](pair(Array T N, seq::take T l (#cast_usize_int(N)), seq::len_take T l (#cast_usize_int(N)) (linarith([]; Eq(Bool, #le_int(0int, #cast_usize_int(N)), true); [1, 1, 0])) (linarith([c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), false)]; Eq(Bool, #le_int(#cast_usize_int(N), seq::len T l), true); [1, 1, 0, 0, 0]))),
                fst(seq::chunks_go T N .hN (seq::drop T l (#cast_usize_int(N))) (#isub(seq::len T l, #cast_usize_int(N))) .(eq::sym Int (seq::len T (seq::drop T l (#cast_usize_int(N)))) (#isub(seq::len T l, #cast_usize_int(N))) (seq::len_drop T l (#cast_usize_int(N)) (linarith([]; Eq(Bool, #le_int(0int, #cast_usize_int(N)), true); [1, 1, 0])) (linarith([c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), false)]; Eq(Bool, #le_int(#cast_usize_int(N), seq::len T l), true); [1, 1, 0, 0, 0])))))),
              linarith([snd(seq::chunks_go T N .hN (seq::drop T l (#cast_usize_int(N))) (#isub(seq::len T l, #cast_usize_int(N))) .(eq::sym Int (seq::len T (seq::drop T l (#cast_usize_int(N)))) (#isub(seq::len T l, #cast_usize_int(N))) (seq::len_drop T l (#cast_usize_int(N)) (linarith([]; Eq(Bool, #le_int(0int, #cast_usize_int(N)), true); [1, 1, 0])) (linarith([c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), false)]; Eq(Bool, #le_int(#cast_usize_int(N), seq::len T l), true); [1, 1, 0, 0, 0]))))) : Eq(Bool, #le_int(seq::len (Array T N) fst(seq::chunks_go T N .hN (seq::drop T l (#cast_usize_int(N))) (#isub(seq::len T l, #cast_usize_int(N))) .(eq::sym Int (seq::len T (seq::drop T l (#cast_usize_int(N)))) (#isub(seq::len T l, #cast_usize_int(N))) (seq::len_drop T l (#cast_usize_int(N)) (linarith([]; Eq(Bool, #le_int(0int, #cast_usize_int(N)), true); [1, 1, 0])) (linarith([c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), false)]; Eq(Bool, #le_int(#cast_usize_int(N), seq::len T l), true); [1, 1, 0, 0, 0]))))), seq::len T (seq::drop T l (#cast_usize_int(N)))), true),
                        seq::len_drop T l (#cast_usize_int(N)) (linarith([]; Eq(Bool, #le_int(0int, #cast_usize_int(N)), true); [1, 1, 0])) (linarith([c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), false)]; Eq(Bool, #le_int(#cast_usize_int(N), seq::len T l), true); [1, 1, 0, 0, 0])) : Eq(Int, seq::len T (seq::drop T l (#cast_usize_int(N))), #isub(seq::len T l, #cast_usize_int(N))),
                        hN : Eq(Bool, #lt_usize(0usize, N), true)];
                       Eq(Bool, #le_int(#iadd(1int, seq::len (Array T N) fst(seq::chunks_go T N .hN (seq::drop T l (#cast_usize_int(N))) (#isub(seq::len T l, #cast_usize_int(N))) .(eq::sym Int (seq::len T (seq::drop T l (#cast_usize_int(N)))) (#isub(seq::len T l, #cast_usize_int(N))) (seq::len_drop T l (#cast_usize_int(N)) (linarith([]; Eq(Bool, #le_int(0int, #cast_usize_int(N)), true); [1, 1, 0])) (linarith([c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), false)]; Eq(Bool, #le_int(#cast_usize_int(N), seq::len T l), true); [1, 1, 0, 0, 0])))))), seq::len T l), true); [1, 1, 1, 1, 0, 0, 0, 0, 0]))
        | true => fun (.c3 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), true)) =>
            pair(Sigma (cs : List(Array T N)), .Eq(Bool, #le_int(seq::len (Array T N) cs, seq::len T l), true), Nil[Array T N], linarith([]; Eq(Bool, #le_int(0int, seq::len T l), true); [1, 1]))
        end;
    eq::trans (List(Array T N)) fst((seq::chunks_c T N .hN l)) fst((mc #lt_int(seq::len T l, #cast_usize_int(N)) .refl(Bool, #lt_int(seq::len T l, #cast_usize_int(N))))) (Nil[Array T N])
      (eq::cong (Sigma (cs : List(Array T N)), .Eq(Bool, #le_int(seq::len (Array T N) cs, seq::len T l), true)) (List(Array T N)) (fun (p : Sigma (cs : List(Array T N)), .Eq(Bool, #le_int(seq::len (Array T N) cs, seq::len T l), true)) => fst(p)) (seq::chunks_c T N .hN l) (mc #lt_int(seq::len T l, #cast_usize_int(N)) .refl(Bool, #lt_int(seq::len T l, #cast_usize_int(N))))
         (delta(seq::chunks_go; T, N, .hN, l, seq::len T l, .refl(Int, seq::len T l))))
      ((transport(Bool, true, #lt_int(seq::len T l, #cast_usize_int(N)), eq::sym Bool (#lt_int(seq::len T l, #cast_usize_int(N))) true c,
          z. (.c2 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), z)) -> Eq(List(Array T N), fst((mc z .c2)), Nil[Array T N]),
          fun (.c2 : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), true)) => refl(List(Array T N), Nil[Array T N]))) .refl(Bool, #lt_int(seq::len T l, #cast_usize_int(N))))

