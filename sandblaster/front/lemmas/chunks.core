    pair(Sigma (_ : Eq(Int, #iadd(#imul(#cast_usize_int(fst(match slice::as_chunks T s $Nusize .hN : Tuple2(Slice (Array T $Nusize), Slice T) as _ return Slice (Array T $Nusize) with | tuple2(cs, rs) => cs end)), $Nint), #cast_usize_int(fst(match slice::as_chunks T s $Nusize .hN : Tuple2(Slice (Array T $Nusize), Slice T) as _ return Slice T with | tuple2(cs, rs) => rs end))), #cast_usize_int(fst(s)))), Eq(Bool, #lt_usize(fst(match slice::as_chunks T s $Nusize .hN : Tuple2(Slice (Array T $Nusize), Slice T) as _ return Slice T with | tuple2(cs, rs) => rs end), $Nusize), true),
