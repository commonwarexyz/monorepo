                    Eq(Bool, #lt_int(seq::len T (seq::drop T l (#cast_usize_int(N))), seq::len T l), true),
                  linarith([]; Eq(Bool, #le_int(0int, seq::len T (seq::drop T l (#cast_usize_int(N)))), true); [1, 1]),
                  linarith([seq::len_drop T l (#cast_usize_int(N)) q0 q1
                              : Eq(Int, seq::len T (seq::drop T l (#cast_usize_int(N))), #isub(seq::len T l, #cast_usize_int(N))),
                            hN : Eq(Bool, #lt_usize(0usize, N), true)];
                           Eq(Bool, #lt_int(seq::len T (seq::drop T l (#cast_usize_int(N))), seq::len T l), true); [1, 1, 1, 0, 0, 0, 0]))))
       | true => fun (h : Eq(Bool, #lt_int(seq::len T l, #cast_usize_int(N)), true)) => h
       end) refl(Bool, #lt_int(seq::len T l, #cast_usize_int(N))))
  measure (seq::len T l)

-- The slice form, about a call `slice::as_chunks T s N .hN`: the
-- remainder's length is below `N` (§3.4 method fact for chunk sizes
-- without an `as_chunks_len_N` lemma).
def[lemma] slice::as_chunks_rest_lt : (T : Type) -> (s : Slice T) -> (N : Usize) -> (.hN : Eq(Bool, #lt_usize(0usize, N), true))
    -> Eq(Bool, #lt_usize(fst(match slice::as_chunks T s N .hN : Tuple2(Slice (Array T N), Slice T) as _ return Slice T with | tuple2(c, r) => r end), N), true) :=
  fun (T : Type) (s : Slice T) (N : Usize) (.hN : Eq(Bool, #lt_usize(0usize, N), true)) =>
    linarith([seq::chunks_rest_c_lt T N .hN fst(snd(s))
                : Eq(Bool, #lt_int(seq::len T fst(seq::chunks_rest_c T N .hN fst(snd(s))), #cast_usize_int(N)), true)];
             Eq(Bool, #lt_usize(fst(match slice::as_chunks T s N .hN : Tuple2(Slice (Array T N), Slice T) as _ return Slice T with | tuple2(c, r) => r end), N), true);
             [1, 1, 0, 0, 0])
