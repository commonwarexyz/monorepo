-- The literal reading's fixed library (docs/mir-lift.md §20.4,
-- docs/checked-structuring.md §2.6). TRUSTED: each definition is the meaning
-- of one MIR construct. Every definition is total. Inside a block a failure
-- is `None` (undefined behaviour, a construct not modeled: MIR statements
-- never panic); a run's outcome is a `mir::Res` (stuck, a value, or a
-- panic, which only a terminator causes). Neither failure ever gives the
-- reading a wrong value. The leaves at the end are emitted into a module's
-- reading where it calls them (they name the lift's models).

-- The outcome of a run, and the state a jump hands to the next block:
-- `Stuck` (out of fuel, undefined behaviour, a construct L does not model),
-- `Ret(v)` (the value), `Panic` (an explicit panic of the code: a failed
-- `Assert` whose failure panics, a call of a panic function, a callee's
-- panic).
inductive mir::Res (A : Type) { | Stuck | Ret(v : A) | Panic }

-- MIR types without a counterpart in the subset, and the slot type of a
-- local whose type the reading does not model (every use of it is `None`).
inductive mir::Infallible { }
inductive mir::Tuple1 (A0 : Type) { | tuple1(x0 : A0) }
inductive mir::ControlFlow (B : Type) (C : Type) { | Continue(c : C) | Break(b : B) }
inductive mir::Unmodeled { | unmodeled }
-- a string constant (`&str`, a panic message): a token without contents
-- (anything that would read its contents is not modeled, so `None`)
inductive mir::Str { | str }

-- A projection of a place, stored in a reference code: a field, a variant
-- (downcast), an array element (the index's value when the place was
-- evaluated), the elements `lo..hi` of an array or a slice (a subslice:
-- `split_at_mut`'s halves, docs/mir-lift.md §20.4). `Deref` is never stored:
-- a place through a reference continues from the reference's own root and
-- path.
inductive mir::Proj { | PField(i : Usize) | PDown(v : Usize) | PIndex(i : Usize) | PRange(lo : Usize, hi : Usize) }

-- A reference code: its root (a local or cell of the frame) and its path.
def[prelude] rc::fst : (R : Type) -> (q : Tuple2(R, List(mir::Proj))) -> R :=
  fun (R : Type) (q : Tuple2(R, List(mir::Proj))) => match q : Tuple2(R, List(mir::Proj)) as _ return R with | tuple2(r, p) => r end
def[prelude] rc::snd : (R : Type) -> (q : Tuple2(R, List(mir::Proj))) -> List(mir::Proj) :=
  fun (R : Type) (q : Tuple2(R, List(mir::Proj))) => match q : Tuple2(R, List(mir::Proj)) as _ return List(mir::Proj) with | tuple2(r, p) => p end

-- Signed comparisons of two's complement bits (`isize` and `i8` are read
-- as their bits, `i16`..`i64` as the lift's bit models): flipping the sign
-- bit makes them unsigned ones.
def[prelude] mir::slt_u64 : (a : U64) -> (b : U64) -> Bool :=
  fun (a : U64) (b : U64) => #lt_u64(#xor_u64(a, 9223372036854775808u64), #xor_u64(b, 9223372036854775808u64))
def[prelude] mir::sle_u64 : (a : U64) -> (b : U64) -> Bool :=
  fun (a : U64) (b : U64) => #le_u64(#xor_u64(a, 9223372036854775808u64), #xor_u64(b, 9223372036854775808u64))
def[prelude] mir::slt_u32 : (a : U32) -> (b : U32) -> Bool :=
  fun (a : U32) (b : U32) => #lt_u32(#xor_u32(a, 2147483648u32), #xor_u32(b, 2147483648u32))
def[prelude] mir::sle_u32 : (a : U32) -> (b : U32) -> Bool :=
  fun (a : U32) (b : U32) => #le_u32(#xor_u32(a, 2147483648u32), #xor_u32(b, 2147483648u32))
def[prelude] mir::slt_u16 : (a : U16) -> (b : U16) -> Bool :=
  fun (a : U16) (b : U16) => #lt_u16(#xor_u16(a, 32768u16), #xor_u16(b, 32768u16))
def[prelude] mir::sle_u16 : (a : U16) -> (b : U16) -> Bool :=
  fun (a : U16) (b : U16) => #le_u16(#xor_u16(a, 32768u16), #xor_u16(b, 32768u16))
def[prelude] mir::slt_u8 : (a : U8) -> (b : U8) -> Bool :=
  fun (a : U8) (b : U8) => #lt_u8(#xor_u8(a, 128u8), #xor_u8(b, 128u8))
def[prelude] mir::sle_u8 : (a : U8) -> (b : U8) -> Bool :=
  fun (a : U8) (b : U8) => #le_u8(#xor_u8(a, 128u8), #xor_u8(b, 128u8))

-- `IntToInt` casts from a signed type to a wider one: sign extension of the
-- bits (`#cast` alone extends with zeros).
def[prelude] mir::sext_u8_u16 : (x : U8) -> U16 :=
  fun (x : U8) => if #lt_u8(x, 128u8) return U16 then #cast_u8_u16(x) else #or_u16(#cast_u8_u16(x), 65280u16)
def[prelude] mir::sext_u8_u32 : (x : U8) -> U32 :=
  fun (x : U8) => if #lt_u8(x, 128u8) return U32 then #cast_u8_u32(x) else #or_u32(#cast_u8_u32(x), 4294967040u32)
def[prelude] mir::sext_u8_u64 : (x : U8) -> U64 :=
  fun (x : U8) => if #lt_u8(x, 128u8) return U64 then #cast_u8_u64(x) else #or_u64(#cast_u8_u64(x), 18446744073709551360u64)
def[prelude] mir::sext_u16_u32 : (x : U16) -> U32 :=
  fun (x : U16) => if #lt_u16(x, 32768u16) return U32 then #cast_u16_u32(x) else #or_u32(#cast_u16_u32(x), 4294901760u32)
def[prelude] mir::sext_u16_u64 : (x : U16) -> U64 :=
  fun (x : U16) => if #lt_u16(x, 32768u16) return U64 then #cast_u16_u64(x) else #or_u64(#cast_u16_u64(x), 18446744073709486080u64)
def[prelude] mir::sext_u32_u64 : (x : U32) -> U64 :=
  fun (x : U32) => if #lt_u32(x, 2147483648u32) return U64 then #cast_u32_u64(x) else #or_u64(#cast_u32_u64(x), 18446744069414584320u64)
-- an arithmetic right shift of two's complement bits (`Shr` of a signed type)
def[prelude] mir::sar_u64 : (a : U64) -> (s : U32) -> U64 :=
  fun (a : U64) (s : U32) => if #lt_u64(a, 9223372036854775808u64) return U64 then #wshr_u64(a, s) else #not_u64(#wshr_u64(#not_u64(a), s))
def[prelude] mir::sar_u32 : (a : U32) -> (s : U32) -> U32 :=
  fun (a : U32) (s : U32) => if #lt_u32(a, 2147483648u32) return U32 then #wshr_u32(a, s) else #not_u32(#wshr_u32(#not_u32(a), s))
def[prelude] mir::sar_u8 : (a : U8) -> (s : U32) -> U8 :=
  fun (a : U8) (s : U32) => if #lt_u8(a, 128u8) return U8 then #wshr_u8(a, s) else #not_u8(#wshr_u8(#not_u8(a), s))
def[prelude] mir::sar_u16 : (a : U16) -> (s : U32) -> U16 :=
  fun (a : U16) (s : U32) => if #lt_u16(a, 32768u16) return U16 then #wshr_u16(a, s) else #not_u16(#wshr_u16(#not_u16(a), s))
-- `CheckedAdd`/`CheckedSub` of a signed type, on its two's complement bits:
-- (the wrapped bits `r`, the overflow flag). The exact sum leaves the type's
-- range exactly when both operands have the same sign and `r` the other
-- one: the sign bit of `(a ^ r) & (b ^ r)`; the exact difference exactly
-- when the operands' signs differ and `r`'s differs from `a`'s: the sign
-- bit of `(a ^ b) & (a ^ r)`. (Signed `CheckedMul` is not modeled.)
def[prelude] mir::scheck_add_u8 : (a : U8) -> (b : U8) -> Tuple2(U8, Bool) :=
  fun (a : U8) (b : U8) => tuple2[U8, Bool](#wadd_u8(a, b), #ge_u8(#and_u8(#xor_u8(a, #wadd_u8(a, b)), #xor_u8(b, #wadd_u8(a, b))), 128u8))
def[prelude] mir::scheck_sub_u8 : (a : U8) -> (b : U8) -> Tuple2(U8, Bool) :=
  fun (a : U8) (b : U8) => tuple2[U8, Bool](#wsub_u8(a, b), #ge_u8(#and_u8(#xor_u8(a, b), #xor_u8(a, #wsub_u8(a, b))), 128u8))
def[prelude] mir::scheck_add_u16 : (a : U16) -> (b : U16) -> Tuple2(U16, Bool) :=
  fun (a : U16) (b : U16) => tuple2[U16, Bool](#wadd_u16(a, b), #ge_u16(#and_u16(#xor_u16(a, #wadd_u16(a, b)), #xor_u16(b, #wadd_u16(a, b))), 32768u16))
def[prelude] mir::scheck_sub_u16 : (a : U16) -> (b : U16) -> Tuple2(U16, Bool) :=
  fun (a : U16) (b : U16) => tuple2[U16, Bool](#wsub_u16(a, b), #ge_u16(#and_u16(#xor_u16(a, b), #xor_u16(a, #wsub_u16(a, b))), 32768u16))
def[prelude] mir::scheck_add_u32 : (a : U32) -> (b : U32) -> Tuple2(U32, Bool) :=
  fun (a : U32) (b : U32) => tuple2[U32, Bool](#wadd_u32(a, b), #ge_u32(#and_u32(#xor_u32(a, #wadd_u32(a, b)), #xor_u32(b, #wadd_u32(a, b))), 2147483648u32))
def[prelude] mir::scheck_sub_u32 : (a : U32) -> (b : U32) -> Tuple2(U32, Bool) :=
  fun (a : U32) (b : U32) => tuple2[U32, Bool](#wsub_u32(a, b), #ge_u32(#and_u32(#xor_u32(a, b), #xor_u32(a, #wsub_u32(a, b))), 2147483648u32))
def[prelude] mir::scheck_add_u64 : (a : U64) -> (b : U64) -> Tuple2(U64, Bool) :=
  fun (a : U64) (b : U64) => tuple2[U64, Bool](#wadd_u64(a, b), #ge_u64(#and_u64(#xor_u64(a, #wadd_u64(a, b)), #xor_u64(b, #wadd_u64(a, b))), 9223372036854775808u64))
def[prelude] mir::scheck_sub_u64 : (a : U64) -> (b : U64) -> Tuple2(U64, Bool) :=
  fun (a : U64) (b : U64) => tuple2[U64, Bool](#wsub_u64(a, b), #ge_u64(#and_u64(#xor_u64(a, b), #xor_u64(a, #wsub_u64(a, b))), 9223372036854775808u64))

-- The option monad of the reading (a failing statement fails the rest).
def[prelude] mir::bind : (A : Type) -> (B : Type) -> (o : Option(A)) -> (f : A -> Option(B)) -> Option(B) :=
  fun (A : Type) (B : Type) (o : Option(A)) (f : A -> Option(B)) =>
    match o : Option(A) as _ return Option(B) with | None => None[B] | Some(x) => f x end
def[prelude] mir::map : (A : Type) -> (B : Type) -> (o : Option(A)) -> (f : A -> B) -> Option(B) :=
  fun (A : Type) (B : Type) (o : Option(A)) (f : A -> B) =>
    match o : Option(A) as _ return Option(B) with | None => None[B] | Some(x) => Some[B](f x) end
-- `assume(c)`: the state, or failure (undefined behaviour).
def[prelude] mir::guard : (S : Type) -> (c : Bool) -> (s : S) -> Option(S) :=
  fun (S : Type) (c : Bool) (s : S) => match c : Bool as _ return Option(S) with | false => None[S] | true => Some[S](s) end

-- A block's `Option` as an outcome: `None` is stuck.
def[prelude] mir::st : (A : Type) -> (o : Option(A)) -> mir::Res(A) :=
  fun (A : Type) (o : Option(A)) => match o : Option(A) as _ return mir::Res(A) with | None => mir::Res::Stuck[A] | Some(x) => mir::Res::Ret[A](x) end
-- `mir::bind` into an outcome: `None` is stuck.
def[prelude] mir::bindr : (A : Type) -> (B : Type) -> (o : Option(A)) -> (f : A -> mir::Res(B)) -> mir::Res(B) :=
  fun (A : Type) (B : Type) (o : Option(A)) (f : A -> mir::Res(B)) =>
    match o : Option(A) as _ return mir::Res(B) with | None => mir::Res::Stuck[B] | Some(x) => f x end
-- A callee's outcome: its value goes on, a panic or stuck is the caller's.
def[prelude] mir::then : (A : Type) -> (B : Type) -> (r : mir::Res(A)) -> (f : A -> mir::Res(B)) -> mir::Res(B) :=
  fun (A : Type) (B : Type) (r : mir::Res(A)) (f : A -> mir::Res(B)) =>
    match r : mir::Res(A) as _ return mir::Res(B) with | Stuck => mir::Res::Stuck[B] | Ret(x) => f x | Panic => mir::Res::Panic[B] end
-- A library function's result whose `None` is exactly where the function
-- panics (the index leaves): `None` a panic.
def[prelude] mir::or_panic : (A : Type) -> (o : Option(A)) -> mir::Res(A) :=
  fun (A : Type) (o : Option(A)) => match o : Option(A) as _ return mir::Res(A) with | None => mir::Res::Panic[A] | Some(x) => mir::Res::Ret[A](x) end
-- `Assert(c, expected)` of a kind whose failure panics (an overflow, a
-- bounds check, a division or remainder by zero), with `c == expected`
-- already compared: the state when it holds, else a panic (the
-- assertion's failure).
def[prelude] mir::check : (S : Type) -> (c : Bool) -> (s : S) -> mir::Res(S) :=
  fun (S : Type) (c : Bool) (s : S) => match c : Bool as _ return mir::Res(S) with | false => mir::Res::Panic[S] | true => mir::Res::Ret[S](s) end
-- `Assert` of any other kind (a misaligned or null pointer dereference, an
-- invalid enum construction: their failure aborts): the state when it
-- holds, else stuck.
def[prelude] mir::check_or_stuck : (S : Type) -> (c : Bool) -> (s : S) -> mir::Res(S) :=
  fun (S : Type) (c : Bool) (s : S) => match c : Bool as _ return mir::Res(S) with | false => mir::Res::Stuck[S] | true => mir::Res::Ret[S](s) end

%for W in u8 u16 u32 u64 usize
-- `CheckedAdd(a, b)` and friends: (the wrapped result, the overflow flag).
def[prelude] mir::checked_add_$w : (a : $W) -> (b : $W) -> Tuple2($W, Bool) :=
  fun (a : $W) (b : $W) => tuple2[$W, Bool](#wadd_$w(a, b), bool::not #le_int(#iadd(#cast_$w_int(a), #cast_$w_int(b)), $MAXint))
def[prelude] mir::checked_sub_$w : (a : $W) -> (b : $W) -> Tuple2($W, Bool) :=
  fun (a : $W) (b : $W) => tuple2[$W, Bool](#wsub_$w(a, b), bool::not #le_$w(b, a))
def[prelude] mir::checked_mul_$w : (a : $W) -> (b : $W) -> Tuple2($W, Bool) :=
  fun (a : $W) (b : $W) => tuple2[$W, Bool](#wmul_$w(a, b), bool::not #le_int(#imul(#cast_$w_int(a), #cast_$w_int(b)), $MAXint))
-- `AddUnchecked` and friends, `Div`, `Rem`: undefined behaviour or a zero
-- divisor is failure.
def[prelude] mir::add_unchecked_$w : (a : $W) -> (b : $W) -> Option($W) :=
  fun (a : $W) (b : $W) => if #le_int(#iadd(#cast_$w_int(a), #cast_$w_int(b)), $MAXint) return Option($W) then Some[$W](#wadd_$w(a, b)) else None[$W]
def[prelude] mir::sub_unchecked_$w : (a : $W) -> (b : $W) -> Option($W) :=
  fun (a : $W) (b : $W) => if #le_$w(b, a) return Option($W) then Some[$W](#wsub_$w(a, b)) else None[$W]
def[prelude] mir::mul_unchecked_$w : (a : $W) -> (b : $W) -> Option($W) :=
  fun (a : $W) (b : $W) => if #le_int(#imul(#cast_$w_int(a), #cast_$w_int(b)), $MAXint) return Option($W) then Some[$W](#wmul_$w(a, b)) else None[$W]
def[prelude] mir::div_$w : (a : $W) -> (b : $W) -> Option($W) :=
  fun (a : $W) (b : $W) => if #ne_$w(b, 0$w) as .h return Option($W) then Some[$W](#div_$w(a, b; h)) else None[$W]
def[prelude] mir::rem_$w : (a : $W) -> (b : $W) -> Option($W) :=
  fun (a : $W) (b : $W) => if #ne_$w(b, 0$w) as .h return Option($W) then Some[$W](#rem_$w(a, b; h)) else None[$W]
-- `ShlUnchecked`/`ShrUnchecked`: undefined behaviour at or above the width.
def[prelude] mir::shl_unchecked_$w : (a : $W) -> (s : U32) -> Option($W) :=
  fun (a : $W) (s : U32) => if #lt_u32(s, $BITSu32) return Option($W) then Some[$W](#wshl_$w(a, s)) else None[$W]
def[prelude] mir::shr_unchecked_$w : (a : $W) -> (s : U32) -> Option($W) :=
  fun (a : $W) (s : U32) => if #lt_u32(s, $BITSu32) return Option($W) then Some[$W](#wshr_$w(a, s)) else None[$W]
-- `BinOp::Cmp`: core's `Ordering`
def[prelude] mir::cmp_$w : (a : $W) -> (b : $W) -> crate::__lift::Ordering :=
  fun (a : $W) (b : $W) =>
    if #lt_$w(a, b) return crate::__lift::Ordering then crate::__lift::Ordering::Less else
    if #eq_$w(a, b) return crate::__lift::Ordering then crate::__lift::Ordering::Equal else crate::__lift::Ordering::Greater
-- `Cast(IntToInt)` of a `bool`
def[prelude] mir::bool_as_$w : (b : Bool) -> $W :=
  fun (b : Bool) => match b : Bool as _ return $W with | false => 0$w | true => 1$w end
%end
-- an array element through an index (failure past the end)
def[prelude] mir::array_get : (T : Type) -> (N : Usize) -> (a : Array T N) -> (i : Usize) -> Option(T) :=
  fun (T : Type) (N : Usize) (a : Array T N) (i : Usize) =>
    if #lt_usize(i, N) as .c return Option(T) then Some[T](array::index T N a i .c) else None[T]
-- an array element update through an index (failure past the end)
def[prelude] mir::array_set : (T : Type) -> (N : Usize) -> (a : Array T N) -> (i : Usize) -> (v : T) -> Option(Array T N) :=
  fun (T : Type) (N : Usize) (a : Array T N) (i : Usize) (v : T) =>
    if #lt_usize(i, N) as .c return Option(Array T N) then Some[Array T N](array::set T N a i v .c) else None[Array T N]
-- an array as a slice (`Unsize`, `&a[..]`), failure past `isize::MAX`
def[prelude] mir::as_slice : (T : Type) -> (N : Usize) -> (a : Array T N) -> Option(Slice T) :=
  fun (T : Type) (N : Usize) (a : Array T N) =>
    if #le_int(#cast_usize_int(N), ISIZE_MAX) as .h return Option(Slice T) then Some[Slice T](array::as_slice T N a .h) else None[Slice T]
-- The index `lo + i` of element `i` of the range `lo..hi` of a sequence of
-- `n` elements: `None` unless `lo <= hi <= n` and `i < hi - lo` (then
-- `lo + i < hi <= n`: the sum does not wrap).
def[prelude] mir::range_index : (n : Usize) -> (lo : Usize) -> (hi : Usize) -> (i : Usize) -> Option(Usize) :=
  fun (n : Usize) (lo : Usize) (hi : Usize) (i : Usize) =>
    if #le_usize(lo, hi) return Option(Usize) then
      (if #le_usize(hi, n) return Option(Usize) then
         (if #lt_int(#cast_usize_int(i), #isub(#cast_usize_int(hi), #cast_usize_int(lo))) return Option(Usize)
          then Some[Usize](#wadd_usize(lo, i))
          else None[Usize])
       else None[Usize])
    else None[Usize]

-- the elements `lo..hi` of a slice, as a slice (failure unless `lo <= hi <= len`)
def[prelude] mir::slice_range : (T : Type) -> (s : Slice T) -> (lo : Usize) -> (hi : Usize) -> Option(Slice T) :=
  fun (T : Type) (s : Slice T) (lo : Usize) (hi : Usize) =>
    if #le_usize(lo, hi) as .h0 return Option(Slice T) then
      (if #le_usize(hi, fst(s)) as .h1 return Option(Slice T) then Some[Slice T](slice::range T s lo hi .h0 .h1) else None[Slice T])
    else None[Slice T]

-- the first `k` elements of a slice (failure past its length)
def[prelude] mir::prefix : (T : Type) -> (s : Slice T) -> (k : Usize) -> Option(Slice T) :=
  fun (T : Type) (s : Slice T) (k : Usize) =>
    mir::map Tuple2(Slice T, Slice T) (Slice T) (slice::split_at_checked T s k) (fun (p : Tuple2(Slice T, Slice T)) => match p : Tuple2(Slice T, Slice T) as _ return Slice T with | tuple2(a, b) => a end)
-- the elements from `k` on (failure past its length)
def[prelude] mir::suffix : (T : Type) -> (s : Slice T) -> (k : Usize) -> Option(Slice T) :=
  fun (T : Type) (s : Slice T) (k : Usize) =>
    mir::map Tuple2(Slice T, Slice T) (Slice T) (slice::split_at_checked T s k) (fun (p : Tuple2(Slice T, Slice T)) => match p : Tuple2(Slice T, Slice T) as _ return Slice T with | tuple2(a, b) => b end)
-- the elements `lo..hi` of an array, as a slice (failure unless `lo <= hi <= N`)
def[prelude] mir::array_range : (T : Type) -> (N : Usize) -> (a : Array T N) -> (lo : Usize) -> (hi : Usize) -> Option(Slice T) :=
  fun (T : Type) (N : Usize) (a : Array T N) (lo : Usize) (hi : Usize) =>
    mir::bind (Slice T) (Slice T) (mir::as_slice T N a) (fun (s : Slice T) => mir::slice_range T s lo hi)

-- `bswap` (the byte-order swap intrinsic): its bytes reversed, by shifts and
-- masks (so that the word normalizer sees through it)
def[prelude] mir::bswap_u16 : (x : U16) -> U16 :=
  fun (x : U16) => #or_u16(#wshl_u16(x, 8u32), #wshr_u16(x, 8u32))
def[prelude] mir::bswap_u32 : (x : U32) -> U32 :=
  fun (x : U32) => #or_u32(#or_u32(#wshl_u32(#and_u32(x, 255u32), 24u32), #wshl_u32(#and_u32(x, 65280u32), 8u32)),
                           #or_u32(#and_u32(#wshr_u32(x, 8u32), 65280u32), #wshr_u32(x, 24u32)))
def[prelude] mir::bswap_u64 : (x : U64) -> U64 :=
  fun (x : U64) => #or_u64(#or_u64(#or_u64(#wshl_u64(#and_u64(x, 255u64), 56u32), #wshl_u64(#and_u64(x, 65280u64), 40u32)),
                                   #or_u64(#wshl_u64(#and_u64(x, 16711680u64), 24u32), #wshl_u64(#and_u64(x, 4278190080u64), 8u32))),
                           #or_u64(#or_u64(#and_u64(#wshr_u64(x, 8u32), 4278190080u64), #and_u64(#wshr_u64(x, 24u32), 16711680u64)),
                                   #or_u64(#and_u64(#wshr_u64(x, 40u32), 65280u64), #wshr_u64(x, 56u32))))
def[prelude] mir::bswap_usize : (x : Usize) -> Usize :=
  fun (x : Usize) => #cast_u64_usize(mir::bswap_u64 (#cast_usize_u64(x)))

-- RAW POINTERS IN CRATE CODE (docs/DESIGN-UNSAFE-SIMD.md §2; docs/mir-lift.md
-- §20.10). A pointer of crate code (`C`: the function's code type): a mutable
-- formation's base, held as its reference code, with the byte offset and the
-- base's size in bytes; or a shared formation's snapshot of the base's bytes,
-- with the byte offset. A store through `PShr`, an offset outside
-- `0..=size` and an access past the end are `None` (stuck), never a value.
inductive mir::Ptr (C : Type) { | PMut(code : C, off : Usize, size : Usize) | PShr(bytes : List(U8), off : Usize) }

-- The elements a[i], a[i+1], .., a[i+k-1] of an array (fewer past its end),
-- each through `f`, concatenated: the array's eta-expansion, with a concrete
-- spine for literal `i` and `k` whatever `a` is.
def[prelude] mem::elems : (T : Type) -> (N : Usize) -> (U : Type) -> (f : T -> List(U)) -> (a : Array T N) -> (i : Usize) -> (k : Int) -> List(U) :=
  fun (T : Type) (N : Usize) (U : Type) (f : T -> List(U)) (a : Array T N) (i : Usize) (k : Int) =>
    if #le_int(k, 0int) as .c return List(U) then Nil[U] else
      if #lt_usize(i, N) as .h return List(U) then
        seq::append U (f (array::index T N a i .h)) (rec(T, N, U, f, a, #wadd_usize(i, 1usize), #isub(k, 1int);
          pair(Sigma (_ : Eq(Bool, #le_int(0int, #isub(k, 1int)), true)), Eq(Bool, #lt_int(#isub(k, 1int), k), true),
               linarith([c : Eq(Bool, #le_int(k, 0int), false)]; Eq(Bool, #le_int(0int, #isub(k, 1int)), true); []),
               linarith([]; Eq(Bool, #lt_int(#isub(k, 1int), k), true); []))))
      else Nil[U]
  measure (k)

-- The elements s[i], s[i+1], .., s[i+k-1] of a slice (fewer past its end),
-- each through `f`, concatenated (a slice's bytes; a concrete spine when
-- `k` and the slice's length are literals).
def[prelude] mem::slice_elems : (T : Type) -> (U : Type) -> (f : T -> List(U)) -> (s : Slice T) -> (i : Usize) -> (k : Int) -> List(U) :=
  fun (T : Type) (U : Type) (f : T -> List(U)) (s : Slice T) (i : Usize) (k : Int) =>
    if #le_int(k, 0int) as .c return List(U) then Nil[U] else
      if #lt_usize(i, fst(s)) as .h return List(U) then
        seq::append U (f (slice::index T s i .h)) (rec(T, U, f, s, #wadd_usize(i, 1usize), #isub(k, 1int);
          pair(Sigma (_ : Eq(Bool, #le_int(0int, #isub(k, 1int)), true)), Eq(Bool, #lt_int(#isub(k, 1int), k), true),
               linarith([c : Eq(Bool, #le_int(k, 0int), false)]; Eq(Bool, #le_int(0int, #isub(k, 1int)), true); []),
               linarith([]; Eq(Bool, #lt_int(#isub(k, 1int), k), true); []))))
      else Nil[U]
  measure (k)

-- A list of exactly `N` elements as an array (`None` for another length).
-- (Its length is bound first: the proof then mentions the number, not the
-- list, whose read-back would be copied into it at each mention.)
def[prelude] mem::arr_of_list : (T : Type) -> (N : Usize) -> (l : List(T)) -> Option(Array T N) :=
  fun (T : Type) (N : Usize) (l : List(T)) =>
    let n : Int = seq::len T l;
    if #le_int(n, #cast_usize_int(N)) as .h0 return Option(Array T N) then
      (if #le_int(#cast_usize_int(N), n) as .h1 return Option(Array T N) then
         Some[Array T N](pair(Array T N, l,
           linarith([h0 : Eq(Bool, #le_int(n, #cast_usize_int(N)), true), h1 : Eq(Bool, #le_int(#cast_usize_int(N), n), true)];
                    Eq(Int, n, #cast_usize_int(N)); [])))
       else None[Array T N])
    else None[Array T N]

-- The one element of a list of exactly one (the byte of a `u8`).
def[prelude] mem::one : (T : Type) -> (l : List(T)) -> Option(T) :=
  fun (T : Type) (l : List(T)) =>
    match l : List(T) as _ return Option(T) with
    | Nil => None[T]
    | Cons(x, t) => match t : List(T) as _ return Option(T) with | Nil => Some[T](x) | Cons(y, u) => None[T] end
    end

-- `n` elements, each of `k` bytes read by `of` from consecutive `k`-byte
-- pieces of `bs` (little-endian words, arrays of them), and nothing left
-- over; `None` otherwise.
def[prelude] mem::pieces : (T : Type) -> (k : Int) -> (of : List(U8) -> Option(T)) -> (n : Int) -> (bs : List(U8)) -> Option(List(T)) :=
  fun (T : Type) (k : Int) (of : List(U8) -> Option(T)) (n : Int) (bs : List(U8)) =>
    if #le_int(n, 0int) as .c return Option(List(T)) then
      (match bs : List(U8) as _ return Option(List(T)) with | Nil => Some[List(T)](Nil[T]) | Cons(b, r) => None[List(T)] end)
    else
      mir::bind T (List(T)) (of (seq::take U8 bs k)) (fun (x : T) =>
        mir::map (List(T)) (List(T)) (rec(T, k, of, #isub(n, 1int), seq::drop U8 bs k;
            pair(Sigma (_ : Eq(Bool, #le_int(0int, #isub(n, 1int)), true)), Eq(Bool, #lt_int(#isub(n, 1int), n), true),
                 linarith([c : Eq(Bool, #le_int(n, 0int), false)]; Eq(Bool, #le_int(0int, #isub(n, 1int)), true); []),
                 linarith([]; Eq(Bool, #lt_int(#isub(n, 1int), n), true); []))))
          (fun (xs : List(T)) => Cons[T](x, xs)))
  measure (n)

-- A list of exactly `n` elements as a slice (`None` for another length).
def[prelude] mem::slice_of_list : (T : Type) -> (n : Usize) -> (l : List(T)) -> Option(Slice T) :=
  fun (T : Type) (n : Usize) (l : List(T)) =>
    if #le_int(seq::len T l, #cast_usize_int(n)) as .h0 return Option(Slice T) then
      (if #le_int(#cast_usize_int(n), seq::len T l) as .h1 return Option(Slice T) then
         (if #le_int(#cast_usize_int(n), ISIZE_MAX) as .h2 return Option(Slice T) then
            Some[Slice T](slice::mk T n l .pair(SliceOk T n l,
              linarith([h0 : Eq(Bool, #le_int(seq::len T l, #cast_usize_int(n)), true), h1 : Eq(Bool, #le_int(#cast_usize_int(n), seq::len T l), true)];
                       Eq(Int, seq::len T l, #cast_usize_int(n)); []),
              h2))
          else None[Slice T])
       else None[Slice T])
    else None[Slice T]

-- `n` bytes of `bs` from byte `off`: `None` unless `off + n ≤ len bs` (an
-- access past the end).
def[prelude] mem::read : (bs : List(U8)) -> (off : Usize) -> (n : Usize) -> Option(List(U8)) :=
  fun (bs : List(U8)) (off : Usize) (n : Usize) =>
    if #le_int(#iadd(#cast_usize_int(off), #cast_usize_int(n)), seq::len U8 bs) return Option(List(U8))
    then Some[List(U8)](seq::take U8 (seq::drop U8 bs (#cast_usize_int(off))) (#cast_usize_int(n)))
    else None[List(U8)]

-- `bs` with the bytes `w` written from byte `off`: `None` unless
-- `off + len w ≤ len bs`.
def[prelude] mem::write : (bs : List(U8)) -> (off : Usize) -> (w : List(U8)) -> Option(List(U8)) :=
  fun (bs : List(U8)) (off : Usize) (w : List(U8)) =>
    if #le_int(#iadd(#cast_usize_int(off), seq::len U8 w), seq::len U8 bs) return Option(List(U8))
    then Some[List(U8)](seq::append U8 (seq::take U8 bs (#cast_usize_int(off))) (seq::append U8 w (seq::drop U8 bs (#iadd(#cast_usize_int(off), seq::len U8 w)))))
    else None[List(U8)]

-- The offset `off + d` (`d` an `Int`) when it stays within `0..=size` (Rust's
-- `add`, `sub` and `offset` are undefined behaviour outside the allocation,
-- even without an access; the base is stricter than the allocation): `None`
-- otherwise.
def[prelude] mem::moved : (off : Usize) -> (d : Int) -> (size : Int) -> Option(Usize) :=
  fun (off : Usize) (d : Int) (size : Int) =>
    if #le_int(0int, #iadd(#cast_usize_int(off), d)) return Option(Usize) then
      (if #le_int(#iadd(#cast_usize_int(off), d), size) return Option(Usize)
       then Some[Usize](#int_to_sat_usize(#iadd(#cast_usize_int(off), d)))
       else None[Usize])
    else None[Usize]

-- A pointer moved by `d` bytes (`add(k)` is `d = k·size_of::<T>()`).
def[prelude] mem::ptr_move : (C : Type) -> (p : mir::Ptr(C)) -> (d : Int) -> Option(mir::Ptr(C)) :=
  fun (C : Type) (p : mir::Ptr(C)) (d : Int) =>
    match p : mir::Ptr(C) as _ return Option(mir::Ptr(C)) with
    | PMut(q, off, size) => mir::map Usize (mir::Ptr(C)) (mem::moved off d (#cast_usize_int(size))) (fun (o : Usize) => mir::Ptr::PMut[C](q, o, size))
    | PShr(bs, off) => mir::map Usize (mir::Ptr(C)) (mem::moved off d (seq::len U8 bs)) (fun (o : Usize) => mir::Ptr::PShr[C](bs, o))
    end

-- The signed value of an `isize`'s bits.
def[prelude] mem::isize_int : (k : U64) -> Int :=
  fun (k : U64) => if #lt_u64(k, 9223372036854775808u64) return Int then #cast_u64_int(k) else #isub(#cast_u64_int(k), 18446744073709551616int)

-- `s` with element `i` replaced by `v` (`None` past its end): the write of a
-- slice element through a reference code.
def[prelude] mir::slice_set : (T : Type) -> (s : Slice T) -> (i : Usize) -> (v : T) -> Option(Slice T) :=
  fun (T : Type) (s : Slice T) (i : Usize) (v : T) =>
    if #lt_usize(i, fst(s)) return Option(Slice T) then
      Some[Slice T](slice::mk T fst(s) (seq::update T fst(snd(s)) (#cast_usize_int(i)) v)
        .pair(SliceOk T fst(s) (seq::update T fst(snd(s)) (#cast_usize_int(i)) v),
              eq::trans Int (seq::len T (seq::update T fst(snd(s)) (#cast_usize_int(i)) v)) (seq::len T fst(snd(s))) (#cast_usize_int(fst(s)))
                (seq::len_update T fst(snd(s)) (#cast_usize_int(i)) v) (slice::ok_len T s),
              slice::ok_bound T s))
    else None[Slice T]

-- LEAVES (each emitted into a reading that calls it; a leaf with a `&mut`
-- argument takes its referent and returns the new referent with the result)

-- `bytes::Buf::try_get_u8(&mut buf)`: the buffer model (the bytes not yet read)
def[prelude] leaf::buf_try_get_u8 : (b : List(U8)) -> Tuple2(List(U8), crate::__lift::Result(U8, crate::__lift::TryGetError)) :=
  fun (b : List(U8)) => crate::__lift_model::buf_try_get_u8 b

-- `bytes::BufMut::put_u8(&mut buf, x)`: the buffer model (the bytes put so far)
def[prelude] leaf::bufmut_put_u8 : (b : List(U8)) -> (x : U8) -> Tuple2(List(U8), Unit) :=
  fun (b : List(U8)) (x : U8) => tuple2[List(U8), Unit](crate::__lift_model::bufmut_put_u8 b x, tt)

-- `bytes::BufMut::put_slice(&mut buf, s)`
def[prelude] leaf::bufmut_put_slice : (b : List(U8)) -> (s : Slice U8) -> Tuple2(List(U8), Unit) :=
  fun (b : List(U8)) (s : Slice U8) => tuple2[List(U8), Unit](crate::__lift_model::bufmut_put_slice b s, tt)

-- `Vec::<T, Global>::push(&mut v, x)`: `Vec<T>` is the list of its elements
def[prelude] leaf::vec_push : (T : Type) -> (v : List(T)) -> (x : T) -> Tuple2(List(T), Unit) :=
  fun (T : Type) (v : List(T)) (x : T) => tuple2[List(T), Unit](crate::__lift_model::vec_push T v x, tt)

-- `Iterator::next(&mut it)` at `Copied<slice::Iter<&[u8]>>`: the byte strings not yet yielded
def[prelude] leaf::bytes_iter_next : (it : Slice (Slice U8)) -> Tuple2(Slice (Slice U8), Option(Slice U8)) :=
  fun (it : Slice (Slice U8)) => crate::__lift::bytes_iter_next it

-- The index leaves: core's `Index::index` of an array or a slice by a range
-- (core's range types, by exact path). Each is the sub-slice, or a panic
-- exactly where core's `index` panics (`slice_*_fail`): `mir::prefix` and
-- `mir::suffix` are `None` exactly past the length. An array is read as its
-- slice first (stuck past `isize::MAX` elements, which only an array of a
-- zero-sized type can have and which no `Slice` holds).

-- `<[T] as Index<RangeToInclusive<usize>>>::index(&s, ..=j)`: `&s[..j + 1]`, a panic unless `j < s.len()`
-- (`j + 1` cannot overflow below the length: the checked sum, its test always true there)
def[prelude] leaf::slice_index_to_inclusive : (T : Type) -> (s : Slice T) -> (j : Usize) -> mir::Res(Slice T) :=
  fun (T : Type) (s : Slice T) (j : Usize) =>
    if #lt_usize(j, slice::len T s) return mir::Res(Slice T) then
      (if #le_int(#iadd(#cast_usize_int(j), #cast_usize_int(1usize)), 18446744073709551615int) as .h return mir::Res(Slice T)
       then mir::or_panic (Slice T) (mir::prefix T s (#add_usize(j, 1usize; h)))
       else mir::Res::Stuck[Slice T])
    else mir::Res::Panic[Slice T]

-- `<[T] as Index<RangeTo<usize>>>::index(&s, ..j)`: `&s[..j]`, a panic unless `j <= s.len()`
def[prelude] leaf::slice_index_to : (T : Type) -> (s : Slice T) -> (j : Usize) -> mir::Res(Slice T) :=
  fun (T : Type) (s : Slice T) (j : Usize) => mir::or_panic (Slice T) (mir::prefix T s j)

-- `<[T] as Index<RangeFrom<usize>>>::index(&s, i..)`: `&s[i..]`, a panic unless `i <= s.len()`
def[prelude] leaf::slice_index_from : (T : Type) -> (s : Slice T) -> (i : Usize) -> mir::Res(Slice T) :=
  fun (T : Type) (s : Slice T) (i : Usize) => mir::or_panic (Slice T) (mir::suffix T s i)

-- `<[T] as Index<Range<usize>>>::index(&s, i..j)`: `&s[i..j]`, a panic unless `i <= j <= s.len()`
def[prelude] leaf::slice_index_range : (T : Type) -> (s : Slice T) -> (i : Usize) -> (j : Usize) -> mir::Res(Slice T) :=
  fun (T : Type) (s : Slice T) (i : Usize) (j : Usize) =>
    if #le_usize(i, j) return mir::Res(Slice T) then
      mir::or_panic (Slice T) (mir::bind (Slice T) (Slice T) (mir::prefix T s j) (fun (p : Slice T) => mir::suffix T p i))
    else mir::Res::Panic[Slice T]

-- `<[T; N] as Index<RangeToInclusive<usize>>>::index(&a, ..=j)`: `&a[..j + 1]`, a panic unless `j < N`
def[prelude] leaf::array_index_to_inclusive : (T : Type) -> (N : Usize) -> (a : Array T N) -> (j : Usize) -> mir::Res(Slice T) :=
  fun (T : Type) (N : Usize) (a : Array T N) (j : Usize) =>
    mir::bindr (Slice T) (Slice T) (mir::as_slice T N a) (fun (s : Slice T) =>
      if #lt_usize(j, slice::len T s) return mir::Res(Slice T) then
        (if #le_int(#iadd(#cast_usize_int(j), #cast_usize_int(1usize)), 18446744073709551615int) as .h return mir::Res(Slice T)
         then mir::or_panic (Slice T) (mir::prefix T s (#add_usize(j, 1usize; h)))
         else mir::Res::Stuck[Slice T])
      else mir::Res::Panic[Slice T])

-- `<[T; N] as Index<RangeTo<usize>>>::index(&a, ..j)`: `&a[..j]`, a panic unless `j <= N`
def[prelude] leaf::array_index_to : (T : Type) -> (N : Usize) -> (a : Array T N) -> (j : Usize) -> mir::Res(Slice T) :=
  fun (T : Type) (N : Usize) (a : Array T N) (j : Usize) =>
    mir::bindr (Slice T) (Slice T) (mir::as_slice T N a) (fun (s : Slice T) => mir::or_panic (Slice T) (mir::prefix T s j))

-- `<[T; N] as Index<RangeFrom<usize>>>::index(&a, i..)`: `&a[i..]`, a panic unless `i <= N`
def[prelude] leaf::array_index_from : (T : Type) -> (N : Usize) -> (a : Array T N) -> (i : Usize) -> mir::Res(Slice T) :=
  fun (T : Type) (N : Usize) (a : Array T N) (i : Usize) =>
    mir::bindr (Slice T) (Slice T) (mir::as_slice T N a) (fun (s : Slice T) => mir::or_panic (Slice T) (mir::suffix T s i))

-- `<[T; N] as Index<Range<usize>>>::index(&a, i..j)`: `&a[i..j]`, a panic unless `i <= j <= N`
def[prelude] leaf::array_index_range : (T : Type) -> (N : Usize) -> (a : Array T N) -> (i : Usize) -> (j : Usize) -> mir::Res(Slice T) :=
  fun (T : Type) (N : Usize) (a : Array T N) (i : Usize) (j : Usize) =>
    mir::bindr (Slice T) (Slice T) (mir::as_slice T N a) (fun (s : Slice T) =>
      if #le_usize(i, j) return mir::Res(Slice T) then
        mir::or_panic (Slice T) (mir::bind (Slice T) (Slice T) (mir::prefix T s j) (fun (p : Slice T) => mir::suffix T p i))
      else mir::Res::Panic[Slice T])

-- `Deref::deref(&d)` of a library newtype of bytes read as its field (SHA-256's `Digest`): `&d[..]`
def[prelude] leaf::bytes_deref : (N : Usize) -> (a : Array U8 N) -> Option(Slice U8) :=
  fun (N : Usize) (a : Array U8 N) => mir::as_slice U8 N a

-- core's `slice::Iter<'_, T>` (raw pointers inside) is the slice and the index
-- of the element it yields next. `<[T]>::iter`, `<&[T] as IntoIterator>::into_iter`
-- and `Iter::new` start it at index 0
def[prelude] leaf::slice_iter_new : (T : Type) -> (s : Slice T) -> Tuple2(Slice T, Usize) :=
  fun (T : Type) (s : Slice T) => tuple2[Slice T, Usize](s, 0usize)

-- `Iterator::next(&mut it)` of a `slice::Iter<'_, T>`: the element at the index
-- (a `&T`, read as its value) with the index one further, or `None` at the end
-- with the iterator unchanged (`i + 1` cannot wrap below the slice's length)
def[prelude] leaf::slice_iter_next : (T : Type) -> (it : Tuple2(Slice T, Usize)) -> Tuple2(Tuple2(Slice T, Usize), Option(T)) :=
  fun (T : Type) (it : Tuple2(Slice T, Usize)) =>
    match it : Tuple2(Slice T, Usize) as _ return Tuple2(Tuple2(Slice T, Usize), Option(T)) with
    | tuple2(s, i) =>
      if #lt_usize(i, slice::len T s) as .c return Tuple2(Tuple2(Slice T, Usize), Option(T))
      then tuple2[Tuple2(Slice T, Usize), Option(T)](tuple2[Slice T, Usize](s, #wadd_usize(i, 1usize)), Some[T](slice::index T s i .c))
      else tuple2[Tuple2(Slice T, Usize), Option(T)](it, None[T])
    end

-- `<Range<usize> as SliceIndex<[T]>>::get(i..j, s)` (`s.get(i..j)`, raw pointers
-- inside): `Some(&s[i..j])` when `i <= j <= s.len()`, else `None` (a value, not a panic)
def[prelude] leaf::slice_get_range : (T : Type) -> (s : Slice T) -> (i : Usize) -> (j : Usize) -> Option(Slice T) :=
  fun (T : Type) (s : Slice T) (i : Usize) (j : Usize) =>
    if #le_usize(i, j) as .h0 return Option(Slice T) then
      (if #le_usize(j, slice::len T s) as .h1 return Option(Slice T) then Some[Slice T](slice::range T s i j .h0 .h1) else None[Slice T])
    else None[Slice T]
