    -> Tuple2(List(Array T N), List(T)) :=
  fun (T : Type) (N : Usize) (.hN : Eq(Bool, #lt_usize(0usize, N), true)) (l : List(T)) =>
    tuple2[List(Array T N), List(T)](seq::chunks T N .hN l, seq::chunks_rest T N .hN l)

def[prelude] slice::as_chunks : (T : Type) -> (s : Slice T) -> (N : Usize) -> (.hN : Eq(Bool, #lt_usize(0usize, N), true))
    -> Tuple2(Slice (Array T N), Slice T) :=
  fun (T : Type) (s : Slice T) (N : Usize) (.hN : Eq(Bool, #lt_usize(0usize, N), true)) =>
    let c : Sigma (c : List(Array T N)), .Eq(Bool, #le_int(seq::len (Array T N) c, seq::len T fst(snd(s))), true) =
      seq::chunks_c T N .hN fst(snd(s));
    let r : Sigma (r : List(T)), .Eq(Bool, #le_int(seq::len T r, seq::len T fst(snd(s))), true) =
      seq::chunks_rest_c T N .hN fst(snd(s));
    let .q0 : Eq(Bool, #le_int(0int, seq::len (Array T N) fst(c)), true) =
      linarith([]; Eq(Bool, #le_int(0int, seq::len (Array T N) fst(c)), true); [1, 1]);
    let .q1 : Eq(Bool, #le_int(seq::len (Array T N) fst(c), 18446744073709551615int), true) =
      linarith([snd(c) : Eq(Bool, #le_int(seq::len (Array T N) fst(c), seq::len T fst(snd(s))), true),
                slice::ok_len T s : Eq(Int, seq::len T fst(snd(s)), #cast_usize_int(fst(s)))];
               Eq(Bool, #le_int(seq::len (Array T N) fst(c), 18446744073709551615int), true); [1, 1, 1, 0, 0, 0, 1]);
