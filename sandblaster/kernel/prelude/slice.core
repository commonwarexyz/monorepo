    let .q3 : Eq(Bool, #le_int(seq::len T fst(r), 18446744073709551615int), true) =
      linarith([snd(r) : Eq(Bool, #le_int(seq::len T fst(r), seq::len T fst(snd(s))), true),
                slice::ok_len T s : Eq(Int, seq::len T fst(snd(s)), #cast_usize_int(fst(s)))];
               Eq(Bool, #le_int(seq::len T fst(r), 18446744073709551615int), true); [1, 1, 1, 0, 0, 0, 1]);
    let nr : Usize = #of_int_usize(seq::len T fst(r); q2, q3);
    tuple2[Slice (Array T N), Slice T](
      slice::mk (Array T N) nc fst(c)
        .pair(SliceOk (Array T N) nc fst(c), refl(Int, seq::len (Array T N) fst(c)),
          linarith([snd(c) : Eq(Bool, #le_int(seq::len (Array T N) fst(c), seq::len T fst(snd(s))), true),
