          linarith([snd(r) : Eq(Bool, #le_int(seq::len T fst(r), seq::len T fst(snd(s))), true),
                    slice::ok_len T s : Eq(Int, seq::len T fst(snd(s)), #cast_usize_int(fst(s))),
                    slice::ok_bound T s : Eq(Bool, #le_int(#cast_usize_int(fst(s)), ISIZE_MAX), true)];
                   Eq(Bool, #le_int(seq::len T fst(r), ISIZE_MAX), true); [1, 1, 1, 1, 0, 0, 0, 0])))
