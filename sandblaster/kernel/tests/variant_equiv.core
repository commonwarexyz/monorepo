def[exec] ve::choose : (x : U32) -> (y : U32) -> (z : U32) -> U32 :=
  fun (x : U32) (y : U32) (z : U32) => #xor_u32(#and_u32(x, y), #and_u32(#not_u32(x), z))
def[exec] ve::majority : (x : U32) -> (y : U32) -> (z : U32) -> U32 :=
  fun (x : U32) (y : U32) (z : U32) => #xor_u32(#xor_u32(#and_u32(x, y), #and_u32(x, z)), #and_u32(y, z))
