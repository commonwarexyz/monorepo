def[exec, opaque] ve::compress : (state : Array U32 8usize) -> (block : Array U8 64usize) -> Array U32 8usize :=
  fun (state : Array U32 8usize) (block : Array U8 64usize) =>
    let w : Array U32 64usize = array::repeat U32 64usize 0u32 .refl(Int, 64int);
    let w0 : Array U32 64usize = ve::compress::loop0 0usize w block .refl(Bool, true);
    let w1 : Array U32 64usize = ve::compress::loop1 16usize w0 .refl(Bool, true) .refl(Bool, true);
    let work : Array U32 8usize = ve::compress::loop2 0usize state w1 .refl(Bool, true);
    ve::finish state work
