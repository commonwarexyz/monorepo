def[spec] arm::compress : (s : Array U32 8usize) -> (b : Array U8 64usize) -> Array U32 8usize :=
  fun (s : Array U32 8usize) (b : Array U8 64usize) =>
    let abcd_in : Array U32 4usize = v4 (array::index U32 8usize s 0usize .refl(Bool, true)) (array::index U32 8usize s 1usize .refl(Bool, true)) (array::index U32 8usize s 2usize .refl(Bool, true)) (array::index U32 8usize s 3usize .refl(Bool, true));
    let efgh_in : Array U32 4usize = v4 (array::index U32 8usize s 4usize .refl(Bool, true)) (array::index U32 8usize s 5usize .refl(Bool, true)) (array::index U32 8usize s 6usize .refl(Bool, true)) (array::index U32 8usize s 7usize .refl(Bool, true));
    let w0 : Array U32 4usize = arm::vreinterpretq_u32_u8 (arm::vrev32q_u8 (arm::chunk0 b));
    let w1 : Array U32 4usize = arm::vreinterpretq_u32_u8 (arm::vrev32q_u8 (arm::chunk1 b));
    let w2 : Array U32 4usize = arm::vreinterpretq_u32_u8 (arm::vrev32q_u8 (arm::chunk2 b));
    let w3 : Array U32 4usize = arm::vreinterpretq_u32_u8 (arm::vrev32q_u8 (arm::chunk3 b));
    let wk0 : Array U32 4usize = arm::vaddq_u32 w0 arm::K4_0;
    let abcd0 : Array U32 4usize = arm::vsha256hq_u32 abcd_in efgh_in wk0;
    let efgh0 : Array U32 4usize = arm::vsha256h2q_u32 efgh_in abcd_in wk0;
    let wk1 : Array U32 4usize = arm::vaddq_u32 w1 arm::K4_1;
    let abcd1 : Array U32 4usize = arm::vsha256hq_u32 abcd0 efgh0 wk1;
    let efgh1 : Array U32 4usize = arm::vsha256h2q_u32 efgh0 abcd0 wk1;
    let wk2 : Array U32 4usize = arm::vaddq_u32 w2 arm::K4_2;
    let abcd2 : Array U32 4usize = arm::vsha256hq_u32 abcd1 efgh1 wk2;
    let efgh2 : Array U32 4usize = arm::vsha256h2q_u32 efgh1 abcd1 wk2;
    let wk3 : Array U32 4usize = arm::vaddq_u32 w3 arm::K4_3;
    let abcd3 : Array U32 4usize = arm::vsha256hq_u32 abcd2 efgh2 wk3;
    let efgh3 : Array U32 4usize = arm::vsha256h2q_u32 efgh2 abcd2 wk3;
    let w4 : Array U32 4usize = arm::vsha256su1q_u32 (arm::vsha256su0q_u32 w0 w1) w2 w3;
    let wk4 : Array U32 4usize = arm::vaddq_u32 w4 arm::K4_4;
    let abcd4 : Array U32 4usize = arm::vsha256hq_u32 abcd3 efgh3 wk4;
    let efgh4 : Array U32 4usize = arm::vsha256h2q_u32 efgh3 abcd3 wk4;
    let w5 : Array U32 4usize = arm::vsha256su1q_u32 (arm::vsha256su0q_u32 w1 w2) w3 w4;
    let wk5 : Array U32 4usize = arm::vaddq_u32 w5 arm::K4_5;
    let abcd5 : Array U32 4usize = arm::vsha256hq_u32 abcd4 efgh4 wk5;
    let efgh5 : Array U32 4usize = arm::vsha256h2q_u32 efgh4 abcd4 wk5;
    let w6 : Array U32 4usize = arm::vsha256su1q_u32 (arm::vsha256su0q_u32 w2 w3) w4 w5;
    let wk6 : Array U32 4usize = arm::vaddq_u32 w6 arm::K4_6;
    let abcd6 : Array U32 4usize = arm::vsha256hq_u32 abcd5 efgh5 wk6;
    let efgh6 : Array U32 4usize = arm::vsha256h2q_u32 efgh5 abcd5 wk6;
    let w7 : Array U32 4usize = arm::vsha256su1q_u32 (arm::vsha256su0q_u32 w3 w4) w5 w6;
    let wk7 : Array U32 4usize = arm::vaddq_u32 w7 arm::K4_7;
    let abcd7 : Array U32 4usize = arm::vsha256hq_u32 abcd6 efgh6 wk7;
    let efgh7 : Array U32 4usize = arm::vsha256h2q_u32 efgh6 abcd6 wk7;
    let w8 : Array U32 4usize = arm::vsha256su1q_u32 (arm::vsha256su0q_u32 w4 w5) w6 w7;
    let wk8 : Array U32 4usize = arm::vaddq_u32 w8 arm::K4_8;
    let abcd8 : Array U32 4usize = arm::vsha256hq_u32 abcd7 efgh7 wk8;
    let efgh8 : Array U32 4usize = arm::vsha256h2q_u32 efgh7 abcd7 wk8;
    let w9 : Array U32 4usize = arm::vsha256su1q_u32 (arm::vsha256su0q_u32 w5 w6) w7 w8;
    let wk9 : Array U32 4usize = arm::vaddq_u32 w9 arm::K4_9;
    let abcd9 : Array U32 4usize = arm::vsha256hq_u32 abcd8 efgh8 wk9;
    let efgh9 : Array U32 4usize = arm::vsha256h2q_u32 efgh8 abcd8 wk9;
    let w10 : Array U32 4usize = arm::vsha256su1q_u32 (arm::vsha256su0q_u32 w6 w7) w8 w9;
    let wk10 : Array U32 4usize = arm::vaddq_u32 w10 arm::K4_10;
    let abcd10 : Array U32 4usize = arm::vsha256hq_u32 abcd9 efgh9 wk10;
    let efgh10 : Array U32 4usize = arm::vsha256h2q_u32 efgh9 abcd9 wk10;
    let w11 : Array U32 4usize = arm::vsha256su1q_u32 (arm::vsha256su0q_u32 w7 w8) w9 w10;
    let wk11 : Array U32 4usize = arm::vaddq_u32 w11 arm::K4_11;
    let abcd11 : Array U32 4usize = arm::vsha256hq_u32 abcd10 efgh10 wk11;
    let efgh11 : Array U32 4usize = arm::vsha256h2q_u32 efgh10 abcd10 wk11;
    let w12 : Array U32 4usize = arm::vsha256su1q_u32 (arm::vsha256su0q_u32 w8 w9) w10 w11;
    let wk12 : Array U32 4usize = arm::vaddq_u32 w12 arm::K4_12;
    let abcd12 : Array U32 4usize = arm::vsha256hq_u32 abcd11 efgh11 wk12;
    let efgh12 : Array U32 4usize = arm::vsha256h2q_u32 efgh11 abcd11 wk12;
    let w13 : Array U32 4usize = arm::vsha256su1q_u32 (arm::vsha256su0q_u32 w9 w10) w11 w12;
    let wk13 : Array U32 4usize = arm::vaddq_u32 w13 arm::K4_13;
    let abcd13 : Array U32 4usize = arm::vsha256hq_u32 abcd12 efgh12 wk13;
    let efgh13 : Array U32 4usize = arm::vsha256h2q_u32 efgh12 abcd12 wk13;
    let w14 : Array U32 4usize = arm::vsha256su1q_u32 (arm::vsha256su0q_u32 w10 w11) w12 w13;
    let wk14 : Array U32 4usize = arm::vaddq_u32 w14 arm::K4_14;
    let abcd14 : Array U32 4usize = arm::vsha256hq_u32 abcd13 efgh13 wk14;
    let efgh14 : Array U32 4usize = arm::vsha256h2q_u32 efgh13 abcd13 wk14;
    let w15 : Array U32 4usize = arm::vsha256su1q_u32 (arm::vsha256su0q_u32 w11 w12) w13 w14;
    let wk15 : Array U32 4usize = arm::vaddq_u32 w15 arm::K4_15;
    let abcd15 : Array U32 4usize = arm::vsha256hq_u32 abcd14 efgh14 wk15;
    let efgh15 : Array U32 4usize = arm::vsha256h2q_u32 efgh14 abcd14 wk15;
    let ao : Array U32 4usize = arm::vaddq_u32 abcd15 abcd_in;
    let eo : Array U32 4usize = arm::vaddq_u32 efgh15 efgh_in;
    v8 (v4::g0 ao) (v4::g1 ao) (v4::g2 ao) (v4::g3 ao) (v4::g0 eo) (v4::g1 eo) (v4::g2 eo) (v4::g3 eo)

-- ---------------------------------------------------------------------------
-- A second FIPS formulation, definitionally equal to `sha::compress` (same
-- operation order), with a different control structure: the 64-word
-- schedule is materialized as a list first (structural recursion over the
-- constants with the sliding window), then the rounds fold over the pairs
-- (K[t], W[t]) (structural recursion over the zipped list).
-- ---------------------------------------------------------------------------

def[spec] sha2::schedule : (ks : List(U32)) -> (x : W16) -> List(U32) :=
  fun (ks : List(U32)) (x : W16) =>
    match ks : List(U32) as _ return List(U32) with
    | Nil => Nil[U32]
    | Cons(k, rest) => Cons[U32](sha::whead x, rec(rest, sha::wnext x))
    end
  structural ks

def[spec] sha2::zip : (ks : List(U32)) -> (ws : List(U32)) -> List(Tuple2(U32, U32)) :=
  fun (ks : List(U32)) (ws : List(U32)) =>
    match ks : List(U32) as _ return List(Tuple2(U32, U32)) with
    | Nil => Nil[Tuple2(U32, U32)]
    | Cons(k, rest) =>
      match ws : List(U32) as _ return List(Tuple2(U32, U32)) with
      | Nil => Nil[Tuple2(U32, U32)]
      | Cons(w, wrest) => Cons[Tuple2(U32, U32)](tuple2[U32, U32](k, w), rec(rest, wrest))
      end
    end
  structural ks

def[spec] sha2::rounds : (s : St) -> (kw : List(Tuple2(U32, U32))) -> St :=
  fun (s : St) (kw : List(Tuple2(U32, U32))) =>
    match kw : List(Tuple2(U32, U32)) as _ return St with
    | Nil => s
    | Cons(p, rest) =>
      match p : Tuple2(U32, U32) as _ return St with
      | tuple2(k, w) => rec(sha::round s k w, rest)
      end
    end
  structural kw

def[spec] sha2::compress : (s : Array U32 8usize) -> (b : Array U8 64usize) -> Array U32 8usize :=
  fun (s : Array U32 8usize) (b : Array U8 64usize) =>
    sha::finish s (sha2::rounds (st(array::index U32 8usize s 0usize .refl(Bool, true), array::index U32 8usize s 1usize .refl(Bool, true),
      array::index U32 8usize s 2usize .refl(Bool, true), array::index U32 8usize s 3usize .refl(Bool, true),
      array::index U32 8usize s 4usize .refl(Bool, true), array::index U32 8usize s 5usize .refl(Bool, true),
      array::index U32 8usize s 6usize .refl(Bool, true), array::index U32 8usize s 7usize .refl(Bool, true)))
      (sha2::zip sha::K (sha2::schedule sha::K (sha::block_words b))))

-- Two chained blocks (a 128-byte message body): the second block's state is
-- the first block's output.
def[spec] sha::compress2 : (s : Array U32 8usize) -> (b0 : Array U8 64usize) -> (b1 : Array U8 64usize) -> Array U32 8usize :=
  fun (s : Array U32 8usize) (b0 : Array U8 64usize) (b1 : Array U8 64usize) => sha::compress (sha::compress s b0) b1
def[spec] sha2::compress2 : (s : Array U32 8usize) -> (b0 : Array U8 64usize) -> (b1 : Array U8 64usize) -> Array U32 8usize :=
  fun (s : Array U32 8usize) (b0 : Array U8 64usize) (b1 : Array U8 64usize) => sha2::compress (sha2::compress s b0) b1
def[spec] arm::compress2 : (s : Array U32 8usize) -> (b0 : Array U8 64usize) -> (b1 : Array U8 64usize) -> Array U32 8usize :=
  fun (s : Array U32 8usize) (b0 : Array U8 64usize) (b1 : Array U8 64usize) => arm::compress (arm::compress s b0) b1
